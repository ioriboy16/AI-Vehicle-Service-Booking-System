@model IEnumerable<AIVehicleWorkshopSystem.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";

    var selectedEntityType =
        ViewBag.SelectedEntityType as string;

    var selectedAction =
        ViewBag.SelectedAction as string;

    var search =
        ViewBag.Search as string;

    var entityTypes =
        ViewBag.EntityTypes as IEnumerable<string>
        ?? Enumerable.Empty<string>();

    var actions =
        ViewBag.Actions as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Audit Logs
            </h2>

            <p class="text-muted mb-0">
                Monitor important activities and
                security-related actions performed in the system.
            </p>
        </div>

        <div class="mt-3 mt-md-0">
            <span class="badge bg-dark fs-6 px-3 py-2">
                @Model.Count() Record(s)
            </span>
        </div>

    </div>


    <!-- FILTER -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-controller="Admin"
                  asp-action="AuditLogs"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- MODULE -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Module
                        </label>

                        <select name="entityType"
                                class="form-select">

                            <option value="">All Modules</option>

                            @foreach (var type in entityTypes)
                            {
                                <option value="@type"
                                        selected="@(type == selectedEntityType)">
                                    @type
                                </option>
                            }

                        </select>

                    </div>


                    <!-- ACTION -->
                    <div class="col-lg-3 col-md-6">

                        <label class="form-label fw-semibold">
                            Action
                        </label>

                        <select name="action"
                                class="form-select">

                            <option value="">All Actions</option>

                            @foreach (var item in actions)
                            {
                                <option value="@item"
                                        selected="@(item == selectedAction)">
                                    @item
                                </option>
                            }

                        </select>

                    </div>


                    <!-- SEARCH -->
                    <div class="col-lg-4 col-md-8">

                        <label class="form-label fw-semibold">
                            Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search user, activity or details..." />

                    </div>


                    <!-- FILTER -->
                    <div class="col-lg-1 col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Filter
                        </button>

                    </div>


                    <!-- RESET -->
                    <div class="col-lg-1 col-md-2">

                        <a asp-controller="Admin"
                           asp-action="AuditLogs"
                           class="btn btn-outline-secondary w-100">
                            Reset
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- SYSTEM ACTIVITY -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between
                        align-items-center">

                <h5 class="fw-bold mb-0">
                    System Activity
                </h5>

                <small class="text-muted">
                    Latest activity first
                </small>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h5 class="text-muted">
                        No audit logs found.
                    </h5>

                    <p class="text-muted mb-0">
                        System activities will appear here
                        when important actions are performed.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                                      table-hover
                                      align-middle
                                      mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">
                                    Date & Time
                                </th>

                                <th>
                                    User
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Activity
                                </th>

                                <th class="pe-4">
                                    Details
                                </th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var log in Model)
                            {
                                // Friendly activity name
                                var activityName = log.Action;

                                switch (log.Action)
                                {
                                    case "ACTIVATE USER":
                                        activityName = "User Activated";
                                        break;

                                    case "DEACTIVATE USER":
                                        activityName = "User Deactivated";
                                        break;

                                    case "ADD MECHANIC":
                                        activityName = "Mechanic Added";
                                        break;

                                    case "APPROVE APPOINTMENT":
                                        activityName = "Appointment Approved";
                                        break;

                                    case "REJECT APPOINTMENT":
                                        activityName = "Appointment Rejected";
                                        break;

                                    case "CREATE REPAIR":
                                        activityName = "Repair Created";
                                        break;

                                    case "ASSIGN AI DIAGNOSTIC":
                                        activityName = "AI Diagnostic Assigned";
                                        break;

                                    case "CREATE INVOICE":
                                        activityName = "Invoice Created";
                                        break;

                                    case "RECORD PAYMENT":
                                        activityName = "Payment Recorded";
                                        break;

                                    case "START REPAIR":
                                        activityName = "Repair Started";
                                        break;

                                    case "UPDATE REPAIR":
                                        activityName = "Repair Updated";
                                        break;

                                    case "COMPLETE REPAIR":
                                        activityName = "Repair Completed";
                                        break;

                                    case "CONFIRM AI DIAGNOSTIC":
                                        activityName = "AI Diagnostic Confirmed";
                                        break;

                                    case "MODIFY AI DIAGNOSTIC":
                                        activityName = "AI Diagnostic Modified";
                                        break;
                                }


                                <tr>

                                    <!-- DATE & TIME -->
                                    <td class="ps-4 text-nowrap">

                                        <div class="fw-semibold">
                                            @log.CreatedAt.ToString(
                                            "dd MMM yyyy")
                                </div>

                                <small class="text-muted">
                                    @log.CreatedAt.ToString(
                                                                        "hh:mm tt")
                                </small>

                            </td>


                            <!-- USER -->
                            <td>

                                <div class="fw-semibold">
                                    @log.UserName
                                </div>

                            </td>


                            <!-- ROLE -->
                            <td>

                                @if (log.UserRole == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                Admin
                                            </span>
                                        }
                                        else if (log.UserRole == "Mechanic")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Mechanic
                                            </span>
                                        }
                                        else if (log.UserRole == "Customer")
                                        {
                                            <span class="badge bg-primary">
                                                Customer
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @log.UserRole
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIVITY -->
                                    <td>

                                        <div class="fw-semibold">
                                            @activityName
                                        </div>

                                        <small class="text-muted">
                                            @log.EntityType
                                        </small>

                                    </td>


                                    <!-- DETAILS -->
                                    <td class="pe-4"
                                        style="min-width: 300px;">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        log.Description))
                                        {
                                            @log.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No additional details.
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>