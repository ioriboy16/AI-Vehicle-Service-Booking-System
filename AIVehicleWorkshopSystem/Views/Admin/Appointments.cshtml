@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("appointmentSearch");

            const clearButton =
                document.getElementById("clearAppointmentSearch");

            const statusFilter =
                document.getElementById("appointmentStatusFilter");

            const rows =
                Array.from(
                    document.querySelectorAll(".appointment-row")
                );

            const visibleCount =
                document.getElementById("visibleAppointmentCount");

            const tableWrapper =
                document.getElementById("appointmentTableWrapper");

            const noResults =
                document.getElementById("appointmentNoResults");

            const resetButton =
                document.getElementById("resetAppointmentFilters");


            if (!searchInput ||
                !statusFilter ||
                rows.length === 0) {

                return;
            }


            function filterAppointments() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusFilter.value
                        .trim()
                        .toLowerCase();

                let count = 0;


                rows.forEach(function (row) {

                    const searchableText = [

                        row.dataset.id || "",
                        row.dataset.customer || "",
                        row.dataset.vehicle || "",
                        row.dataset.plate || "",
                        row.dataset.service || ""

                    ]
                    .join(" ")
                    .toLowerCase();


                    const matchesSearch =
                        search === "" ||
                        searchableText.includes(search);


                    const matchesStatus =
                        status === "all" ||
                        (row.dataset.status || "") === status;


                    const show =
                        matchesSearch &&
                        matchesStatus;


                    row.style.display =
                        show ? "" : "none";


                    if (show) {
                        count++;
                    }

                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (clearButton) {

                    clearButton.classList.toggle(
                        "show",
                        searchInput.value.length > 0
                    );

                }


                if (count === 0) {

                    if (tableWrapper) {
                        tableWrapper.style.display = "none";
                    }

                    if (noResults) {
                        noResults.classList.add("show");
                    }

                }
                else {

                    if (tableWrapper) {
                        tableWrapper.style.display = "";
                    }

                    if (noResults) {
                        noResults.classList.remove("show");
                    }

                }

            }


            /* SEARCH */
            searchInput.addEventListener(
                "input",
                filterAppointments
            );


            /* STATUS */
            statusFilter.addEventListener(
                "change",
                filterAppointments
            );


            /* CLEAR SEARCH */
            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        searchInput.focus();

                        filterAppointments();

                    }
                );

            }


            /* RESET */
            if (resetButton) {

                resetButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        statusFilter.value = "all";

                        filterAppointments();

                    }
                );

            }


            filterAppointments();

        });

    </script>
}