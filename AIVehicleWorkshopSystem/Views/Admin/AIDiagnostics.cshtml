@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("diagnosticSearch");

            const statusFilter =
                document.getElementById("diagnosticStatusFilter");

            const priorityFilter =
                document.getElementById("diagnosticPriorityFilter");

            const clearButton =
                document.getElementById("clearDiagnosticSearch");

            const resetButton =
                document.getElementById("resetDiagnosticFilters");

            const visibleCount =
                document.getElementById("visibleDiagnosticCount");

            const tableWrapper =
                document.getElementById("diagnosticTableWrapper");

            const noResults =
                document.getElementById("diagnosticNoResults");

            const rows =
                Array.from(
                    document.querySelectorAll(".diagnostic-row")
                );


            if (!searchInput ||
                !statusFilter ||
                !priorityFilter ||
                rows.length === 0) {

                return;
            }


            function filterDiagnostics() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusFilter.value
                        .trim()
                        .toLowerCase();

                const priority =
                    priorityFilter.value
                        .trim()
                        .toLowerCase();


                let count = 0;


                rows.forEach(function (row) {

                    const searchableText = [

                        row.dataset.id || "",
                        row.dataset.customer || "",
                        row.dataset.vehicle || "",
                        row.dataset.plate || "",
                        row.dataset.mechanic || ""

                    ]
                    .join(" ")
                    .toLowerCase();


                    const matchesSearch =
                        search === "" ||
                        searchableText.includes(search);


                    const matchesStatus =
                        status === "all" ||
                        (row.dataset.status || "") === status;


                    const matchesPriority =
                        priority === "all" ||
                        (row.dataset.priority || "") === priority;


                    const show =
                        matchesSearch &&
                        matchesStatus &&
                        matchesPriority;


                    row.style.display =
                        show ? "" : "none";


                    if (show) {
                        count++;
                    }

                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (clearButton) {

                    clearButton.classList.toggle(
                        "show",
                        searchInput.value.length > 0
                    );

                }


                if (count === 0) {

                    if (tableWrapper) {
                        tableWrapper.style.display = "none";
                    }

                    if (noResults) {
                        noResults.classList.add("show");
                    }

                }
                else {

                    if (tableWrapper) {
                        tableWrapper.style.display = "";
                    }

                    if (noResults) {
                        noResults.classList.remove("show");
                    }

                }

            }


            /* SEARCH */
            searchInput.addEventListener(
                "input",
                filterDiagnostics
            );


            /* STATUS */
            statusFilter.addEventListener(
                "change",
                filterDiagnostics
            );


            /* PRIORITY */
            priorityFilter.addEventListener(
                "change",
                filterDiagnostics
            );


            /* CLEAR SEARCH */
            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        searchInput.focus();

                        filterDiagnostics();

                    }
                );

            }


            /* RESET FILTERS */
            if (resetButton) {

                resetButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        statusFilter.value = "all";

                        priorityFilter.value = "all";

                        filterDiagnostics();

                    }
                );

            }


            filterDiagnostics();

        });

    </script>
}