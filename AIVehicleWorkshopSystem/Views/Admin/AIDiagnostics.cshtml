@model IEnumerable<AIVehicleWorkshopSystem.Models.AIDiagnostic>

@{
    ViewData["Title"] = "AI Diagnostics";

    var customerNames =
        ViewBag.CustomerNames as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var mechanicNames =
        ViewBag.MechanicNames as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var totalDiagnostics = Model.Count();

    var pendingAssignment =
        Model.Count(d =>
            d.ReviewStatus == "Pending Assignment");

    var pendingReview =
        Model.Count(d =>
            d.ReviewStatus == "Pending Review");

    var reviewed =
        Model.Count(d =>
            d.ReviewStatus == "Confirmed" ||
            d.ReviewStatus == "Modified");
}


<div class="diagnostic-management-page">

    <div class="container py-4 py-lg-5">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="diagnostic-page-header">

            <div>

                <div class="page-label">
                    <i class="bi bi-cpu-fill"></i>
                    AI DIAGNOSTIC MANAGEMENT
                </div>

                <h2>
                    AI Diagnostic Management
                </h2>

                <p>
                    Review customer AI diagnostic requests and assign them to available mechanics.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="dashboard-button">

                <i class="bi bi-arrow-left"></i>
                Back to Dashboard

            </a>

        </div>


        <!-- =====================================================
             MESSAGES
             ===================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show
                            border-0 shadow-sm rounded-3 mb-4">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show
                            border-0 shadow-sm rounded-3 mb-4">

                <i class="bi bi-exclamation-circle-fill me-2"></i>

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- TOTAL -->
            <div class="col-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon total">
                        <i class="bi bi-cpu"></i>
                    </div>

                    <div>

                        <span>
                            Total Diagnostics
                        </span>

                        <strong>
                            @totalDiagnostics
                        </strong>

                    </div>

                </div>

            </div>


            <!-- PENDING ASSIGNMENT -->
            <div class="col-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon assignment">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div>

                        <span>
                            Pending Assignment
                        </span>

                        <strong class="assignment-number">
                            @pendingAssignment
                        </strong>

                    </div>

                </div>

            </div>


            <!-- PENDING REVIEW -->
            <div class="col-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon review">
                        <i class="bi bi-search"></i>
                    </div>

                    <div>

                        <span>
                            Pending Review
                        </span>

                        <strong class="review-number">
                            @pendingReview
                        </strong>

                    </div>

                </div>

            </div>


            <!-- REVIEWED -->
            <div class="col-6 col-xl-3">

                <div class="summary-card">

                    <div class="summary-icon reviewed">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <div>

                        <span>
                            Reviewed
                        </span>

                        <strong class="reviewed-number">
                            @reviewed
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
             ===================================================== -->

        <div class="diagnostic-card">


            <!-- CARD HEADER -->
            <div class="diagnostic-card-header">

                <div class="diagnostic-card-title">

                    <div class="card-title-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>

                        <h4>
                            Diagnostic Requests
                        </h4>

                        <p>
                            New requests requiring assignment are displayed first.
                        </p>

                    </div>

                </div>


                <div class="record-count">

                    <strong>
                        @totalDiagnostics
                    </strong>

                    <span>
                        Records
                    </span>

                </div>

            </div>


            @if (!Model.Any())
            {
                <!-- =================================================
                     EMPTY
                     ================================================= -->

                <div class="empty-state">

                    <div class="empty-icon">
                        <i class="bi bi-cpu"></i>
                    </div>

                    <h5>
                        No AI diagnostics available
                    </h5>

                    <p>
                        Customer AI diagnostic requests will appear here.
                    </p>

                </div>
            }
            else
            {
                <!-- =================================================
                     SEARCH & FILTER
                     ================================================= -->

                <div class="diagnostic-toolbar">

                    <div class="toolbar-left">


                        <!-- SEARCH -->
                        <div class="diagnostic-search">

                            <i class="bi bi-search"></i>

                            <input type="text"
                                   id="diagnosticSearch"
                                   placeholder="Search ID, customer, vehicle, plate or mechanic..."
                                   autocomplete="off" />

                            <button type="button"
                                    id="clearDiagnosticSearch"
                                    class="clear-search"
                                    aria-label="Clear search">

                                <i class="bi bi-x-lg"></i>

                            </button>

                        </div>


                        <!-- STATUS -->
                        <select id="diagnosticStatusFilter"
                                class="diagnostic-filter">

                            <option value="all">
                                All Status
                            </option>

                            <option value="pending assignment">
                                Pending Assignment
                            </option>

                            <option value="pending review">
                                Pending Review
                            </option>

                            <option value="confirmed">
                                Confirmed
                            </option>

                            <option value="modified">
                                Modified
                            </option>

                        </select>


                        <!-- PRIORITY -->
                        <select id="diagnosticPriorityFilter"
                                class="diagnostic-filter priority-filter">

                            <option value="all">
                                All Priority
                            </option>

                            <option value="high">
                                High
                            </option>

                            <option value="medium">
                                Medium
                            </option>

                            <option value="low">
                                Low
                            </option>

                        </select>

                    </div>


                    <!-- RESULT COUNT -->
                    <div class="result-count">

                        Showing

                        <strong id="visibleDiagnosticCount">
                            @totalDiagnostics
                        </strong>

                        of

                        <strong>
                            @totalDiagnostics
                        </strong>

                    </div>

                </div>


                <!-- =================================================
                     TABLE
                     ================================================= -->

                <div class="table-responsive diagnostic-table-wrapper"
                     id="diagnosticTableWrapper">

                    <table class="table diagnostic-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>
                                    ID
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Vehicle
                                </th>

                                <th class="text-center">
                                    Priority
                                </th>

                                <th>
                                    Assigned Mechanic
                                </th>

                                <th class="text-center">
                                    Status
                                </th>

                                <th>
                                    Generated
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var diagnostic in Model)
                            {
                                var customerName =
                                customerNames.ContainsKey(diagnostic.CustomerId)
                                ? customerNames[diagnostic.CustomerId]
                                : "Unknown Customer";

                                var assignedMechanic =
                                !string.IsNullOrEmpty(diagnostic.AssignedMechanicId)
                                && mechanicNames.ContainsKey(diagnostic.AssignedMechanicId)
                                ? mechanicNames[diagnostic.AssignedMechanicId]
                                : "Not Assigned";

                                var vehicleName =
                                diagnostic.Vehicle != null
                                ? $"{diagnostic.Vehicle.Brand} {diagnostic.Vehicle.Model}"
                                : "";

                                var plateNumber =
                                diagnostic.Vehicle?.PlateNumber ?? "";

                                var priority =
                                diagnostic.Priority ?? "";

                                var reviewStatus =
                                diagnostic.ReviewStatus ?? "";


                                <tr class="diagnostic-row"
                                    data-id="@diagnostic.DiagnosticId"
                                    data-customer="@customerName"
                                    data-vehicle="@vehicleName"
                                    data-plate="@plateNumber"
                                    data-mechanic="@assignedMechanic"
                                    data-priority="@priority.ToLower()"
                                    data-status="@reviewStatus.ToLower()">


                                    <!-- ID -->
                                    <td>

                                        <div class="diagnostic-id">

                                            <div class="diagnostic-id-icon">
                                                <i class="bi bi-stars"></i>
                                            </div>

                                            <div>

                                                <span>
                                                    AI
                                                </span>

                                                <strong>
                                                    #@diagnostic.DiagnosticId
                                                </strong>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CUSTOMER -->
                                    <td>

                                        <div class="customer-cell">

                                            <div class="customer-icon">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div>

                                                <strong>
                                                    @customerName
                                                </strong>

                                                <span>
                                                    Customer
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- VEHICLE -->
                                    <td>

                                        @if (diagnostic.Vehicle != null)
                                        {
                                            <div class="vehicle-cell">

                                                <div class="vehicle-icon">
                                                    <i class="bi bi-car-front-fill"></i>
                                                </div>

                                                <div>

                                                    <strong>
                                                        @diagnostic.Vehicle.Brand
                                                        @diagnostic.Vehicle.Model
                                                    </strong>

                                                    <span>
                                                        @diagnostic.Vehicle.PlateNumber
                                                    </span>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="unavailable">
                                                Vehicle unavailable
                                            </span>
                                        }

                                    </td>


                                    <!-- PRIORITY -->
                                    <td class="text-center">

                                        @if (diagnostic.Priority == "High")
                                        {
                                            <span class="priority-badge high">

                                                <i class="bi bi-exclamation-circle-fill"></i>
                                                High

                                            </span>
                                        }
                                        else if (diagnostic.Priority == "Medium")
                                        {
                                            <span class="priority-badge medium">

                                                <i class="bi bi-dash-circle-fill"></i>
                                                Medium

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="priority-badge low">

                                                <i class="bi bi-arrow-down-circle-fill"></i>
                                                Low

                                            </span>
                                        }

                                    </td>


                                    <!-- MECHANIC -->
                                    <td>

                                        @if (string.IsNullOrEmpty(
                                                                        diagnostic.AssignedMechanicId))
                                        {
                                            <div class="mechanic-unassigned">

                                                <i class="bi bi-person-plus"></i>

                                                <span>
                                                    Not Assigned
                                                </span>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mechanic-cell">

                                                <div class="mechanic-icon">
                                                    <i class="bi bi-person-gear"></i>
                                                </div>

                                                <div>

                                                    <strong>
                                                        @assignedMechanic
                                                    </strong>

                                                    <span>
                                                        Mechanic
                                                    </span>

                                                </div>

                                            </div>
                                        }

                                    </td>


                                    <!-- STATUS -->
                                    <td class="text-center">

                                        @if (diagnostic.ReviewStatus ==
                                                                        "Pending Assignment")
                                        {
                                            <span class="status-badge assignment">

                                                <i class="bi bi-person-plus-fill"></i>
                                                Pending Assignment

                                            </span>
                                        }
                                        else if (diagnostic.ReviewStatus ==
                                        "Pending Review")
                                        {
                                            <span class="status-badge review">

                                                <i class="bi bi-clock-fill"></i>
                                                Pending Review

                                            </span>
                                        }
                                        else if (diagnostic.ReviewStatus ==
                                        "Confirmed")
                                        {
                                            <span class="status-badge confirmed">

                                                <i class="bi bi-check-circle-fill"></i>
                                                Confirmed

                                            </span>
                                        }
                                        else if (diagnostic.ReviewStatus ==
                                        "Modified")
                                        {
                                            <span class="status-badge modified">

                                                <i class="bi bi-pencil-fill"></i>
                                                Modified

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge default-status">
                                                @diagnostic.ReviewStatus
                                            </span>
                                        }

                                    </td>


                                    <!-- GENERATED -->
                                    <td>

                                        <div class="generated-cell">

                                            <strong>
                                                @diagnostic.CreatedAt.ToString("dd MMM yyyy")
                                            </strong>

                                            <span>

                                                <i class="bi bi-clock"></i>

                                                @diagnostic.CreatedAt.ToString("hh:mm tt")

                                            </span>

                                        </div>

                                    </td>


                                    <!-- ACTION -->
                                    <td class="text-end">

                                        <a asp-controller="Admin"
                                           asp-action="AIDiagnosticDetails"
                                           asp-route-id="@diagnostic.DiagnosticId"
                                           class="view-button">

                                            @if (diagnostic.ReviewStatus ==
                                                                                "Pending Assignment")
                                            {
                                                <i class="bi bi-person-plus-fill"></i>

                                                <span>
                                                    Assign
                                                </span>
                                            }
                                            else
                                            {
                                                <span>
                                                    View
                                                </span>

                                                <i class="bi bi-arrow-right"></i>
                                            }

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =================================================
                     NO RESULTS
                     ================================================= -->

                <div id="diagnosticNoResults"
                     class="no-results">

                    <div class="no-results-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h5>
                        No diagnostics found
                    </h5>

                    <p>
                        Try changing your search, status or priority filter.
                    </p>

                    <button type="button"
                            id="resetDiagnosticFilters"
                            class="reset-button">

                        Reset Filters

                    </button>

                </div>
            }

        </div>

    </div>

</div>


<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .diagnostic-management-page {
        min-height: 100vh;
        background: #f6f8fb;
    }

        .diagnostic-management-page > .container {
            max-width: 1300px;
        }


    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .diagnostic-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .page-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .7px;
    }

    .diagnostic-page-header h2 {
        margin: 0 0 5px;
        color: #252d38;
        font-size: 34px;
        font-weight: 750;
    }

    .diagnostic-page-header p {
        margin: 0;
        color: #87909b;
        font-size: 14px;
    }


    /* =========================================================
           BACK BUTTON
           ========================================================= */

    .dashboard-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 16px;
        color: #5f6975;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #dce1e6;
        border-radius: 9px;
        transition: .15s ease;
        white-space: nowrap;
    }

        .dashboard-button:hover {
            color: #0d6efd;
            background: #f8fbff;
            border-color: #b9d3ff;
        }


    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .summary-card {
        min-height: 110px;
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #ffffff;
        border: 1px solid #e5e9ee;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(0, 0, 0, .025);
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
        border-radius: 11px;
    }

        .summary-icon.total {
            color: #0d6efd;
            background: #eaf2ff;
        }

        .summary-icon.assignment {
            color: #9b7000;
            background: #fff6d9;
        }

        .summary-icon.review {
            color: #6554c0;
            background: #f0edff;
        }

        .summary-icon.reviewed {
            color: #198754;
            background: #eaf8f0;
        }

    .summary-card span {
        display: block;
        margin-bottom: 3px;
        color: #8b949f;
        font-size: 11px;
    }

    .summary-card strong {
        display: block;
        color: #303945;
        font-size: 23px;
        line-height: 1.2;
    }

    .summary-card .assignment-number {
        color: #9b7000;
    }

    .summary-card .review-number {
        color: #6554c0;
    }

    .summary-card .reviewed-number {
        color: #198754;
    }


    /* =========================================================
           MAIN CARD
           ========================================================= */

    .diagnostic-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e5e9ee;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }


    /* =========================================================
           CARD HEADER
           ========================================================= */

    .diagnostic-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf0f3;
    }

    .diagnostic-card-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .card-title-icon {
        width: 41px;
        height: 41px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #0d6efd;
        font-size: 16px;
        background: #eaf2ff;
        border-radius: 10px;
    }

    .diagnostic-card-header h4 {
        margin: 0 0 2px;
        color: #303945;
        font-size: 17px;
        font-weight: 750;
    }

    .diagnostic-card-header p {
        margin: 0;
        color: #929ba6;
        font-size: 11px;
    }

    .record-count {
        min-width: 70px;
        padding: 9px 13px;
        text-align: center;
        background: #f6f8fa;
        border-radius: 9px;
    }

        .record-count strong {
            display: block;
            color: #303945;
            font-size: 16px;
        }

        .record-count span {
            display: block;
            color: #929ba6;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }


    /* =========================================================
           TOOLBAR
           ========================================================= */

    .diagnostic-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 18px;
        background: #fafbfc;
        border-bottom: 1px solid #edf0f3;
    }

    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
    }


    /* =========================================================
           SEARCH
           ========================================================= */

    .diagnostic-search {
        position: relative;
        width: 100%;
        max-width: 430px;
    }

        .diagnostic-search > i {
            position: absolute;
            top: 50%;
            left: 14px;
            z-index: 2;
            color: #8c96a2;
            font-size: 13px;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .diagnostic-search input {
            width: 100%;
            height: 42px;
            padding: 7px 37px 7px 39px;
            color: #414b56;
            font-size: 12px;
            background: #ffffff;
            border: 1px solid #dfe4ea;
            border-radius: 8px;
            outline: none;
            transition: .15s ease;
        }

            .diagnostic-search input::placeholder {
                color: #9ba4ae;
            }

            .diagnostic-search input:focus,
            .diagnostic-filter:focus {
                border-color: #86b7fe;
                box-shadow: 0 0 0 3px rgba(13, 110, 253, .07);
            }

    .clear-search {
        position: absolute;
        top: 50%;
        right: 10px;
        display: none;
        padding: 2px;
        color: #8a949f;
        font-size: 11px;
        background: transparent;
        border: 0;
        transform: translateY(-50%);
    }

        .clear-search.show {
            display: block;
        }


    /* =========================================================
           FILTER
           ========================================================= */

    .diagnostic-filter {
        width: 170px;
        height: 42px;
        padding: 6px 30px 6px 12px;
        color: #505a65;
        font-size: 12px;
        background-color: #ffffff;
        border: 1px solid #dfe4ea;
        border-radius: 8px;
        outline: none;
        cursor: pointer;
    }

    .priority-filter {
        width: 145px;
    }

    .result-count {
        flex-shrink: 0;
        color: #8b949f;
        font-size: 11px;
        white-space: nowrap;
    }

        .result-count strong {
            color: #505a65;
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .diagnostic-table-wrapper {
        padding: 0 10px 10px;
    }

    .diagnostic-table {
        font-size: 13px;
    }

        .diagnostic-table thead th {
            padding: 15px 10px;
            color: #7e8894;
            font-size: 10px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .4px;
            background: #fafbfc;
            border-bottom: 1px solid #e9edf1;
            white-space: nowrap;
        }

        .diagnostic-table tbody td {
            padding: 14px 10px;
            color: #4e5864;
            border-color: #edf0f3;
            vertical-align: middle;
        }

        .diagnostic-table tbody tr {
            transition: .15s ease;
        }

            .diagnostic-table tbody tr:hover td {
                background: #fafcff;
            }


    /* =========================================================
           DIAGNOSTIC ID
           ========================================================= */

    .diagnostic-id {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .diagnostic-id-icon {
        width: 33px;
        height: 33px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #0d6efd;
        background: #edf4ff;
        border-radius: 8px;
    }

    .diagnostic-id span {
        display: block;
        color: #929ba6;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .diagnostic-id strong {
        display: block;
        color: #3e4853;
        font-size: 12px;
    }


    /* =========================================================
           CUSTOMER / VEHICLE / MECHANIC
           ========================================================= */

    .customer-cell,
    .vehicle-cell,
    .mechanic-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .customer-icon,
    .vehicle-icon,
    .mechanic-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 8px;
    }

    .customer-icon {
        color: #6f42c1;
        background: #f2ecff;
    }

    .vehicle-icon {
        color: #0d6efd;
