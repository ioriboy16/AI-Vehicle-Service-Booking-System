@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("repairSearch");

            const statusFilter =
                document.getElementById("repairStatusFilter");

            const clearButton =
                document.getElementById("clearRepairSearch");

            const resetButton =
                document.getElementById("resetRepairFilters");

            const visibleCount =
                document.getElementById("visibleRepairCount");

            const tableWrapper =
                document.getElementById("repairTableWrapper");

            const noResults =
                document.getElementById("repairNoResults");

            const rows =
                Array.from(
                    document.querySelectorAll(".repair-row")
                );


            if (!searchInput ||
                !statusFilter ||
                rows.length === 0) {

                return;
            }


            function filterRepairs() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusFilter.value
                        .trim()
                        .toLowerCase();

                let count = 0;


                rows.forEach(function (row) {

                    const searchableText = [

                        row.dataset.repair || "",
                        row.dataset.vehicle || "",
                        row.dataset.plate || "",
                        row.dataset.mechanic || "",
                        row.dataset.service || ""

                    ]
                    .join(" ")
                    .toLowerCase();


                    const matchesSearch =
                        search === "" ||
                        searchableText.includes(search);


                    const matchesStatus =
                        status === "all" ||
                        (row.dataset.status || "") === status;


                    const show =
                        matchesSearch &&
                        matchesStatus;


                    row.style.display =
                        show ? "" : "none";


                    if (show) {
                        count++;
                    }

                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (clearButton) {

                    clearButton.classList.toggle(
                        "show",
                        searchInput.value.length > 0
                    );

                }


                if (count === 0) {

                    if (tableWrapper) {
                        tableWrapper.style.display = "none";
                    }

                    if (noResults) {
                        noResults.classList.add("show");
                    }

                }
                else {

                    if (tableWrapper) {
                        tableWrapper.style.display = "";
                    }

                    if (noResults) {
                        noResults.classList.remove("show");
                    }

                }

            }


            /* LIVE SEARCH */
            searchInput.addEventListener(
                "input",
                filterRepairs
            );


            /* STATUS FILTER */
            statusFilter.addEventListener(
                "change",
                filterRepairs
            );


            /* CLEAR SEARCH */
            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        searchInput.focus();

                        filterRepairs();

                    }
                );

            }


            /* RESET */
            if (resetButton) {

                resetButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        statusFilter.value = "all";

                        filterRepairs();

                    }
                );

            }


            filterRepairs();

        });

    </script>
}