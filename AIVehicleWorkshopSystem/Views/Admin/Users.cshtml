@model IEnumerable<AIVehicleWorkshopSystem.Models.ApplicationUser>

@using Microsoft.AspNetCore.Identity
@using AIVehicleWorkshopSystem.Models

@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "User Management";

    var userRoles =
        ViewBag.UserRoles as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var decryptedPhoneNumbers =
        ViewBag.DecryptedPhoneNumbers as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var currentUserId = UserManager.GetUserId(User);

    var totalUsers = Model?.Count() ?? 0;
    var activeUsers = Model?.Count(u => u.IsActive) ?? 0;
    var inactiveUsers = totalUsers - activeUsers;
    var mechanicCount = Model?.Count(u =>
        userRoles.ContainsKey(u.Id) &&
        userRoles[u.Id] == "Mechanic") ?? 0;
}

<style>
    /* =========================================
           USER MANAGEMENT
        ========================================= */

    .user-management-page {
        min-height: 100vh;
        background: #f7f9fc;
    }

    .page-label {
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .page-title {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: .35rem;
    }

    .page-description {
        color: #6b7280;
    }

    /* =========================================
           ADD MECHANIC BUTTON
        ========================================= */

    .btn-add-mechanic {
        border-radius: 10px;
        padding: .7rem 1.2rem;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(13, 110, 253, .15);
        transition: all .2s ease;
    }

        .btn-add-mechanic:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(13, 110, 253, .22);
        }

    /* =========================================
           SUMMARY CARDS
        ========================================= */

    .summary-card {
        background: #fff;
        border: 1px solid #edf0f5;
        border-radius: 14px;
        padding: 1rem 1.2rem;
        height: 100%;
        transition: all .2s ease;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, .06);
        }

    .summary-label {
        color: #6b7280;
        font-size: .82rem;
        font-weight: 500;
        margin-bottom: .25rem;
    }

    .summary-value {
        font-size: 1.45rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .icon-total {
        background: #eef4ff;
        color: #0d6efd;
    }

    .icon-active {
        background: #eaf8ef;
        color: #198754;
    }

    .icon-inactive {
        background: #fff0f1;
        color: #dc3545;
    }

    .icon-mechanic {
        background: #fff7e6;
        color: #d97706;
    }

    /* =========================================
           FILTER CARD
        ========================================= */

    .filter-card {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
        }

    .search-input {
        padding-left: 42px;
        height: 44px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }

        .search-input:focus,
        .filter-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .10);
        }

    .filter-select {
        height: 44px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }

    .btn-clear-filter {
        height: 44px;
        border-radius: 10px;
        white-space: nowrap;
    }

    .filter-label {
        color: #6b7280;
        font-size: .78rem;
        font-weight: 600;
        margin-bottom: .4rem;
    }

    /* =========================================
           TABLE
        ========================================= */

    .user-table-card {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }

    .table-header-area {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #edf0f5;
        background: #fff;
    }

    .table-title {
        font-weight: 700;
        color: #1f2937;
        margin-bottom: .15rem;
    }

    .result-text {
        color: #6b7280;
        font-size: .85rem;
    }

    .user-table {
        margin-bottom: 0;
    }

        .user-table thead th {
            background: #f8fafc;
            color: #6b7280;
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .025em;
            border-bottom: 1px solid #e9ecef;
            white-space: nowrap;
            padding-top: .9rem;
            padding-bottom: .9rem;
        }

        .user-table tbody td {
            padding-top: 1rem;
            padding-bottom: 1rem;
            border-color: #f0f2f5;
            vertical-align: middle;
        }

        .user-table tbody tr {
            transition: background-color .15s ease;
        }

            .user-table tbody tr:hover {
                background-color: #fafcff;
            }

    /* =========================================
           USER AVATAR
        ========================================= */

    .user-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .9rem;
        text-transform: uppercase;
    }

    .user-name {
        color: #1f2937;
        font-weight: 600;
    }

    .user-subtext {
        color: #9ca3af;
        font-size: .76rem;
    }

    /* =========================================
           BADGES
        ========================================= */

    .role-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: .38rem .65rem;
        border-radius: 20px;
        font-size: .75rem;
        font-weight: 600;
    }

    .role-admin {
        background: #f0f1f3;
        color: #343a40;
    }

    .role-mechanic {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .role-customer {
        background: #e8f8fb;
        color: #087990;
    }

    .role-other {
        background: #f1f3f5;
        color: #6c757d;
    }

    .status-active {
        background: #eaf8ef;
        color: #198754;
    }

    .status-inactive {
        background: #fff0f1;
        color: #dc3545;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* =========================================
           ACTION BUTTONS
        ========================================= */

    .action-btn {
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 600;
        padding: .4rem .7rem;
    }

    .current-account-badge {
        background: #f8f9fa;
        color: #6b7280;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        font-size: .75rem;
        padding: .4rem .65rem;
        display: inline-block;
    }

    /* =========================================
           EMPTY FILTER RESULT
        ========================================= */

    .no-results {
        display: none;
        text-align: center;
        padding: 3.5rem 1rem;
    }

    .no-results-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #64748b;
    }

    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 767.98px) {

        .page-header-actions {
            width: 100%;
        }

        .btn-add-mechanic {
            width: 100%;
        }

        .table-header-area {
            padding: .9rem 1rem;
        }
    }

    /* =========================================
       DARK MODE - USER MANAGEMENT
    ========================================= */

    [data-bs-theme="dark"] .user-management-page {
        background: var(--bs-body-bg);
    }

    [data-bs-theme="dark"] .page-title,
    [data-bs-theme="dark"] .summary-value,
    [data-bs-theme="dark"] .table-title,
    [data-bs-theme="dark"] .user-name {
        color: var(--bs-body-color);
    }

    [data-bs-theme="dark"] .page-description,
    [data-bs-theme="dark"] .summary-label,
    [data-bs-theme="dark"] .result-text,
    [data-bs-theme="dark"] .filter-label,
    [data-bs-theme="dark"] .user-subtext {
        color: var(--bs-secondary-color);
    }

    [data-bs-theme="dark"] .summary-card,
    [data-bs-theme="dark"] .filter-card,
    [data-bs-theme="dark"] .user-table-card,
    [data-bs-theme="dark"] .table-header-area {
        background: var(--bs-body-bg);
        border-color: var(--bs-border-color);
    }

    [data-bs-theme="dark"] .filter-card {
        box-shadow: 0 4px 18px rgba(0, 0, 0, .15);
    }

    [data-bs-theme="dark"] .search-input,
    [data-bs-theme="dark"] .filter-select {
        background-color: var(--bs-body-bg);
        border-color: var(--bs-border-color);
        color: var(--bs-body-color);
    }

        [data-bs-theme="dark"] .search-input::placeholder {
            color: var(--bs-secondary-color);
        }

    [data-bs-theme="dark"] .user-table {
        --bs-table-bg: transparent;
        --bs-table-color: var(--bs-body-color);
        --bs-table-border-color: var(--bs-border-color);
    }

        [data-bs-theme="dark"] .user-table thead th {
            background: var(--bs-tertiary-bg);
            color: var(--bs-secondary-color);
            border-color: var(--bs-border-color);
        }

        [data-bs-theme="dark"] .user-table tbody td {
            color: var(--bs-body-color);
            border-color: var(--bs-border-color);
        }

        [data-bs-theme="dark"] .user-table tbody tr:hover {
            background-color: var(--bs-tertiary-bg);
        }

            [data-bs-theme="dark"] .user-table tbody tr:hover > * {
                background-color: var(--bs-tertiary-bg);
            }

        [data-bs-theme="dark"] .user-table .text-secondary {
            color: var(--bs-secondary-color) !important;
        }

    [data-bs-theme="dark"] .current-account-badge {
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        border-color: var(--bs-border-color);
    }

    [data-bs-theme="dark"] .no-results-icon {
        background: var(--bs-tertiary-bg);
        color: var(--bs-secondary-color);
    }

    /* Keep semantic badges readable */

    [data-bs-theme="dark"] .role-admin {
        background: #343a40;
        color: #f8f9fa;
    }

    [data-bs-theme="dark"] .role-mechanic {
        background: rgba(13, 110, 253, .18);
        color: #6ea8fe;
    }

    [data-bs-theme="dark"] .role-customer {
        background: rgba(13, 202, 240, .15);
        color: #6edff6;
    }

    [data-bs-theme="dark"] .role-other {
        background: var(--bs-tertiary-bg);
        color: var(--bs-secondary-color);
    }

    [data-bs-theme="dark"] .status-active {
        background: rgba(25, 135, 84, .18);
        color: #75b798;
    }

    [data-bs-theme="dark"] .status-inactive {
        background: rgba(220, 53, 69, .18);
        color: #ea868f;
    }

</style>


<section class="user-management-page py-5">

    <div class="container">

        <!-- =========================================
             HEADER
        ========================================== -->

        <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3 mb-4">

            <div>

                <div class="page-label text-primary mb-2">
                    Administration
                </div>

                <h1 class="page-title">
                    User Management
                </h1>

                <p class="page-description mb-0">
                    Manage customers, mechanics and system access.
                </p>

            </div>

            <div class="page-header-actions">

                <a asp-controller="Admin"
                   asp-action="AddMechanic"
                   class="btn btn-primary btn-add-mechanic">

                    <span class="me-1">+</span>
                    Add Mechanic

                </a>

            </div>

        </div>


        <!-- =========================================
             SUCCESS MESSAGE
        ========================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3"
                 role="alert">

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- =========================================
             ERROR MESSAGE
        ========================================== -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3"
                 role="alert">

                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        <!-- =========================================
             SUMMARY
        ========================================== -->

        <div class="row g-3 mb-4">

            <!-- TOTAL USERS -->

            <div class="col-6 col-lg-3">

                <div class="summary-card">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="summary-label">
                                Total Users
                            </div>

                            <p class="summary-value">
                                @totalUsers
                            </p>

                        </div>

                        <div class="summary-icon icon-total">
                            👤
                        </div>

                    </div>

                </div>

            </div>


            <!-- ACTIVE USERS -->

            <div class="col-6 col-lg-3">

                <div class="summary-card">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="summary-label">
                                Active Users
                            </div>

                            <p class="summary-value">
                                @activeUsers
                            </p>

                        </div>

                        <div class="summary-icon icon-active">
                            ✓
                        </div>

                    </div>

                </div>

            </div>


            <!-- INACTIVE USERS -->

            <div class="col-6 col-lg-3">

                <div class="summary-card">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="summary-label">
                                Inactive Users
                            </div>

                            <p class="summary-value">
                                @inactiveUsers
                            </p>

                        </div>

                        <div class="summary-icon icon-inactive">
                            ×
                        </div>

                    </div>

                </div>

            </div>


            <!-- MECHANICS -->

            <div class="col-6 col-lg-3">

                <div class="summary-card">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="summary-label">
                                Mechanics
                            </div>

                            <p class="summary-value">
                                @mechanicCount
                            </p>

                        </div>

                        <div class="summary-icon icon-mechanic">
                            🔧
                        </div>

                    </div>

                </div>

            </div>

        </div>


        @if (Model == null || !Model.Any())
        {
            <!-- =========================================
                 NO USERS
            ========================================== -->

            <div class="user-table-card">

                <div class="text-center p-5">

                    <div class="no-results-icon">
                        👤
                    </div>

                    <h5 class="fw-bold mb-2">
                        No users found
                    </h5>

                    <p class="text-muted mb-0">
                        User accounts will appear here once they are registered.
                    </p>

                </div>

            </div>
        }
        else
        {

            <!-- =========================================
                 SEARCH & FILTER
            ========================================== -->

            <div class="filter-card mb-4">

                <div class="card-body p-3 p-md-4">

                    <div class="row g-3 align-items-end">

                        <!-- SEARCH -->

                        <div class="col-12 col-lg-6">

                            <label class="filter-label">
                                Search Users
                            </label>

                            <div class="search-wrapper">

                                <span class="search-icon">
                                    🔍
                                </span>

                                <input type="text"
                                       id="userSearch"
                                       class="form-control search-input"
                                       placeholder="Search name, username, email or phone..."
                                       autocomplete="off" />

                            </div>

                        </div>


                        <!-- ROLE FILTER -->

                        <div class="col-6 col-lg-2">

                            <label class="filter-label">
                                Role
                            </label>

                            <select id="roleFilter"
                                    class="form-select filter-select">

                                <option value="">
                                    All Roles
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>

                                <option value="Mechanic">
                                    Mechanic
                                </option>

                                <option value="Customer">
                                    Customer
                                </option>

                            </select>

                        </div>


                        <!-- STATUS FILTER -->

                        <div class="col-6 col-lg-2">

                            <label class="filter-label">
                                Status
                            </label>

                            <select id="statusFilter"
                                    class="form-select filter-select">

                                <option value="">
                                    All Status
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                        </div>


                        <!-- CLEAR FILTER -->

                        <div class="col-12 col-lg-2">

                            <button type="button"
                                    id="clearFilters"
                                    class="btn btn-outline-secondary btn-clear-filter w-100">

                                Clear Filters

                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================================
                 USER TABLE
            ========================================== -->

            <div class="user-table-card">

                <!-- TABLE HEADER -->

                <div class="table-header-area">

                    <div class="d-flex flex-column flex-sm-row
                                    justify-content-between
                                    align-items-sm-center
                                    gap-1">

                        <div>

                            <div class="table-title">
                                System Users
                            </div>

                            <div class="result-text">
                                Customer, mechanic and administrator accounts.
                            </div>

                        </div>

                        <div class="result-text">

                            Showing
                            <strong id="visibleUserCount">
                                @totalUsers
                            </strong>
                            of
                            <strong>
                                @totalUsers
                            </strong>
                            users

                        </div>

                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table user-table align-middle">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    User
                                </th>

                                <th>
                                    Username
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created
                                </th>

                                <th class="text-center pe-4">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody id="userTableBody">

                            @foreach (var user in Model)
                            {
                                var role =
                                userRoles.ContainsKey(user.Id)
                                ? userRoles[user.Id]
                                : "No Role";

                                var phoneNumber =
                                decryptedPhoneNumbers.ContainsKey(user.Id)
                                ? decryptedPhoneNumbers[user.Id]
                                : "-";

                                var status =
                                user.IsActive
                                ? "Active"
                                : "Inactive";

                                var fullName = user.FullName ?? "-";
                                var username = user.UserName ?? "-";
                                var email = user.Email ?? "-";

                                var initials = "?";

                                if (!string.IsNullOrWhiteSpace(fullName))
                                {
                                    var nameParts = fullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                    if (nameParts.Length >= 2)
                                    {
                                        initials =
                                        $"{nameParts[0][0]}{nameParts[1][0]}";
                                    }
                                    else if (nameParts.Length == 1)
                                    {
                                        initials =
                                        nameParts[0][0].ToString();
                                    }
                                }


                                <tr class="user-row"
                                    data-name="@fullName.ToLower()"
                                    data-username="@username.ToLower()"
                                    data-email="@email.ToLower()"
                                    data-phone="@phoneNumber.ToLower()"
                                    data-role="@role"
                                    data-status="@status">


                                    <!-- USER -->

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="user-avatar">
                                                @initials
                                            </div>

                                            <div>

                                                <div class="user-name">
                                                    @fullName
                                                </div>

                                                @if (user.Id == currentUserId)
                                                {
                                                    <div class="user-subtext text-primary fw-semibold">
                                                        Current account
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="user-subtext">
                                                        User account
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- USERNAME -->

                                    <td>

                                        <span class="text-secondary">
                                            @username
                                        </span>

                                    </td>


                                    <!-- EMAIL -->

                                    <td>

                                        <span class="text-secondary">
                                            @email
                                        </span>

                                    </td>


                                    <!-- PHONE -->

                                    <td>

                                        <span class="text-secondary">
                                            @phoneNumber
                                        </span>

                                    </td>


                                    <!-- ROLE -->

                                    <td>

                                        @if (role == "Admin")
                                        {
                                            <span class="role-badge role-admin">
                                                Admin
                                            </span>
                                        }
                                        else if (role == "Mechanic")
                                        {
                                            <span class="role-badge role-mechanic">
                                                Mechanic
                                            </span>
                                        }
                                        else if (role == "Customer")
                                        {
                                            <span class="role-badge role-customer">
                                                Customer
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="role-badge role-other">
                                                @role
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="status-badge status-active">

                                                <span class="status-dot"></span>

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">

                                                <span class="status-dot"></span>

                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- CREATED -->

                                    <td>

                                        <span class="text-secondary text-nowrap">
                                            @user.CreatedAt.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-center pe-4">

                                        @if (user.Id == currentUserId)
                                        {
                                            <span class="current-account-badge">
                                                Current Account
                                            </span>
                                        }
                                        else if (user.IsActive)
                                        {
                                            <!-- DEACTIVATE -->

                                            <form asp-controller="Admin"
                                                  asp-action="DeactivateUser"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to deactivate @user.FullName? This user will no longer be able to log in.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger action-btn">

                                                    Deactivate

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- ACTIVATE -->

                                            <form asp-controller="Admin"
                                                  asp-action="ActivateUser"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to activate @user.FullName?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success action-btn">

                                                    Activate

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <!-- =========================================
                     NO SEARCH RESULTS
                ========================================== -->

                <div id="noSearchResults"
                     class="no-results">

                    <div class="no-results-icon">
                        🔍
                    </div>

                    <h5 class="fw-bold mb-2">
                        No matching users
                    </h5>

                    <p class="text-muted mb-3">
                        Try changing your search keyword or filters.
                    </p>

                    <button type="button"
                            id="clearFiltersEmpty"
                            class="btn btn-outline-primary btn-sm px-3">

                        Clear Filters

                    </button>

                </div>

            </div>
        }

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("userSearch");

            const roleFilter =
                document.getElementById("roleFilter");

            const statusFilter =
                document.getElementById("statusFilter");

            const clearButton =
                document.getElementById("clearFilters");

            const clearEmptyButton =
                document.getElementById("clearFiltersEmpty");

            const userRows =
                document.querySelectorAll(".user-row");

            const visibleCount =
                document.getElementById("visibleUserCount");

            const noResults =
                document.getElementById("noSearchResults");


            // =========================================
            // FILTER USERS
            // =========================================

            function filterUsers() {

                const searchValue =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const selectedRole =
                    roleFilter.value;

                const selectedStatus =
                    statusFilter.value;

                let visibleUsers = 0;


                userRows.forEach(function (row) {

                    const name =
                        row.dataset.name || "";

                    const username =
                        row.dataset.username || "";

                    const email =
                        row.dataset.email || "";

                    const phone =
                        row.dataset.phone || "";

                    const role =
                        row.dataset.role || "";

                    const status =
                        row.dataset.status || "";


                    // SEARCH MATCH
                    const matchesSearch =
                        searchValue === "" ||
                        name.includes(searchValue) ||
                        username.includes(searchValue) ||
                        email.includes(searchValue) ||
                        phone.includes(searchValue);


                    // ROLE MATCH
                    const matchesRole =
                        selectedRole === "" ||
                        role === selectedRole;


                    // STATUS MATCH
                    const matchesStatus =
                        selectedStatus === "" ||
                        status === selectedStatus;


                    // SHOW / HIDE ROW
                    if (
                        matchesSearch &&
                        matchesRole &&
                        matchesStatus
                    ) {

                        row.style.display = "";
                        visibleUsers++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });


                // UPDATE RESULT COUNT
                if (visibleCount) {

                    visibleCount.textContent =
                        visibleUsers;

                }


                // SHOW EMPTY SEARCH STATE
                if (noResults) {

                    if (visibleUsers === 0) {

                        noResults.style.display =
                            "block";

                    }
                    else {

                        noResults.style.display =
                            "none";

                    }

                }

            }


            // =========================================
            // CLEAR FILTERS
            // =========================================

            function clearFilters() {

                searchInput.value = "";

                roleFilter.value = "";

                statusFilter.value = "";

                filterUsers();

                searchInput.focus();

            }


            // =========================================
            // EVENTS
            // =========================================

            if (searchInput) {

                searchInput.addEventListener(
                    "input",
                    filterUsers
                );

            }


            if (roleFilter) {

                roleFilter.addEventListener(
                    "change",
                    filterUsers
                );

            }


            if (statusFilter) {

                statusFilter.addEventListener(
                    "change",
                    filterUsers
                );

            }


            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    clearFilters
                );

            }


            if (clearEmptyButton) {

                clearEmptyButton.addEventListener(
                    "click",
                    clearFilters
                );

            }

        });

    </script>

}