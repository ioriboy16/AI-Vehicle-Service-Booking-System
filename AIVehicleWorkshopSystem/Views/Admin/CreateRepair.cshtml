@model AIVehicleWorkshopSystem.Models.Repair

@{
    ViewData["Title"] = "Create Repair";

    var appointment =
        ViewBag.Appointment
        as AIVehicleWorkshopSystem.Models.Appointment;
}

<style>

    /* =========================================
           PAGE
        ========================================= */

    .create-repair-page {
        min-height: 100vh;
        background: #f7f9fc;
    }

    .create-repair-container {
        max-width: 950px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #6b7280;
        font-size: .84rem;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 1.4rem;
        transition: color .15s ease;
    }

        .back-link:hover {
            color: #0d6efd;
        }

    .page-label {
        color: #0d6efd;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: .45rem;
    }

    .page-title {
        color: #1f2937;
        font-weight: 700;
        margin-bottom: .35rem;
    }

    .page-description {
        color: #6b7280;
        margin-bottom: 0;
    }


    /* =========================================
           MAIN CARD
        ========================================= */

    .repair-form-card {
        background: #ffffff;
        border: 1px solid #edf0f5;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }

    .repair-form-header {
        padding: 1.3rem 1.5rem;
        background: #ffffff;
        border-bottom: 1px solid #edf0f5;
    }

    .repair-form-body {
        padding: 1.5rem;
    }

    .section-title {
        color: #1f2937;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: .2rem;
    }

    .section-description {
        color: #8b95a5;
        font-size: .8rem;
        margin-bottom: 0;
    }


    /* =========================================
           APPOINTMENT HEADER
        ========================================= */

    .appointment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .appointment-title {
        color: #1f2937;
        font-size: .95rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .appointment-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: .38rem .65rem;
        background: #eef4ff;
        color: #0d6efd;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .appointment-badge-dot {
        width: 6px;
        height: 6px;
        background: currentColor;
        border-radius: 50%;
    }


    /* =========================================
           APPOINTMENT INFO
        ========================================= */

    .appointment-box {
        padding: 1.2rem;
        background: #fafbfc;
        border: 1px solid #edf0f5;
        border-radius: 12px;
        margin-bottom: 1.75rem;
    }

    .info-item {
        height: 100%;
        padding: .9rem 1rem;
        background: #ffffff;
        border: 1px solid #edf0f5;
        border-radius: 10px;
    }

    .info-label {
        color: #8b95a5;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .4rem;
    }

    .info-value {
        color: #374151;
        font-size: .88rem;
        font-weight: 600;
        margin-bottom: .1rem;
    }

    .info-secondary {
        color: #8b95a5;
        font-size: .75rem;
        margin-bottom: 0;
    }

    .complaint-item {
        padding: 1rem;
        background: #ffffff;
        border: 1px solid #edf0f5;
        border-radius: 10px;
    }

    .complaint-text {
        color: #4b5563;
        font-size: .86rem;
        line-height: 1.6;
        margin-bottom: 0;
    }


    /* =========================================
           ASSIGN MECHANIC SECTION
        ========================================= */

    .assignment-section {
        margin-top: .3rem;
    }

    .assignment-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 1.25rem;
    }

    .assignment-number {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef4ff;
        color: #0d6efd;
        font-size: .72rem;
        font-weight: 700;
    }

    .assignment-title {
        color: #1f2937;
        font-size: .93rem;
        font-weight: 700;
        margin-bottom: .1rem;
    }

    .assignment-description {
        color: #8b95a5;
        font-size: .77rem;
        margin-bottom: 0;
    }


    /* =========================================
           FORM
        ========================================= */

    .form-label {
        color: #374151;
        font-size: .82rem;
        font-weight: 600;
        margin-bottom: .45rem;
    }

    .required-mark {
        color: #dc3545;
    }

    .mechanic-select {
        min-height: 48px;
        border: 1px solid #dfe3e8;
        border-radius: 10px;
        padding-left: .9rem;
        font-size: .86rem;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .mechanic-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .08);
        }

    .form-help {
        color: #9ca3af;
        font-size: .73rem;
        margin-top: .45rem;
    }


    /* =========================================
           STATUS NOTICE
        ========================================= */

    .status-notice {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: .95rem 1rem;
        background: #f8fbff;
        border: 1px solid #dce8f8;
        border-radius: 10px;
        margin-top: 1.4rem;
    }

    .status-notice-icon {
        width: 29px;
        height: 29px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eaf2ff;
        color: #0d6efd;
        font-size: .72rem;
        font-weight: 700;
    }

    .status-notice-title {
        color: #374151;
        font-size: .78rem;
        font-weight: 700;
        margin-bottom: .12rem;
    }

    .status-notice-text {
        color: #6b7280;
        font-size: .76rem;
        line-height: 1.5;
        margin-bottom: 0;
    }

    .assigned-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: .22rem .48rem;
        margin: 0 .1rem;
        background: #eaf2ff;
        color: #0d6efd;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 700;
    }

    .assigned-status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
    }


    /* =========================================
           ACTION AREA
        ========================================= */

    .form-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding-top: 1.5rem;
        margin-top: 1.5rem;
        border-top: 1px solid #edf0f5;
    }

    .action-btn {
        min-height: 43px;
        padding: .55rem 1.1rem;
        border-radius: 9px;
        font-size: .82rem;
        font-weight: 600;
    }

    .create-btn {
        min-width: 220px;
    }


    /* =========================================
           NO APPOINTMENT
        ========================================= */

    .appointment-error {
        padding: 1rem;
        background: #fff5f5;
        border: 1px solid #f3d2d5;
        border-radius: 10px;
        color: #842029;
        font-size: .82rem;
        margin-bottom: 1.5rem;
    }


    /* =========================================
           DARK MODE
        ========================================= */

    [data-bs-theme="dark"] .create-repair-page {
        background: var(--bs-body-bg);
    }

    [data-bs-theme="dark"] .page-title,
    [data-bs-theme="dark"] .section-title,
    [data-bs-theme="dark"] .appointment-title,
    [data-bs-theme="dark"] .info-value,
    [data-bs-theme="dark"] .assignment-title,
    [data-bs-theme="dark"] .form-label,
    [data-bs-theme="dark"] .status-notice-title {
        color: var(--bs-body-color);
    }

    [data-bs-theme="dark"] .page-description,
    [data-bs-theme="dark"] .section-description,
    [data-bs-theme="dark"] .info-label,
    [data-bs-theme="dark"] .info-secondary,
    [data-bs-theme="dark"] .assignment-description,
    [data-bs-theme="dark"] .form-help,
    [data-bs-theme="dark"] .back-link {
        color: var(--bs-secondary-color);
    }


    /* MAIN CARD */

    [data-bs-theme="dark"] .repair-form-card,
    [data-bs-theme="dark"] .repair-form-header {
        background: var(--bs-body-bg);
        border-color: var(--bs-border-color);
    }


    /* APPOINTMENT */

    [data-bs-theme="dark"] .appointment-box {
        background: var(--bs-tertiary-bg);
        border-color: var(--bs-border-color);
    }

    [data-bs-theme="dark"] .info-item,
    [data-bs-theme="dark"] .complaint-item {
        background: var(--bs-body-bg);
        border-color: var(--bs-border-color);
    }

    [data-bs-theme="dark"] .complaint-text {
        color: var(--bs-body-color);
    }


    /* SELECT */

    [data-bs-theme="dark"] .mechanic-select {
        background-color: var(--bs-body-bg);
        border-color: var(--bs-border-color);
        color: var(--bs-body-color);
    }

        [data-bs-theme="dark"] .mechanic-select option {
            background: var(--bs-body-bg);
            color: var(--bs-body-color);
        }


    /* STATUS NOTICE */

    [data-bs-theme="dark"] .status-notice {
        background: rgba(13, 110, 253, .08);
        border-color: rgba(13, 110, 253, .25);
    }

    [data-bs-theme="dark"] .status-notice-text {
        color: var(--bs-secondary-color);
    }

    [data-bs-theme="dark"] .status-notice-icon,
    [data-bs-theme="dark"] .appointment-badge,
    [data-bs-theme="dark"] .assignment-number,
    [data-bs-theme="dark"] .assigned-status {
        background: rgba(13, 110, 253, .18);
        color: #6ea8fe;
    }


    /* ACTION AREA */

    [data-bs-theme="dark"] .form-actions {
        border-color: var(--bs-border-color);
    }


    /* ERROR */

    [data-bs-theme="dark"] .appointment-error {
        background: rgba(220, 53, 69, .12);
        border-color: rgba(220, 53, 69, .3);
        color: #ea868f;
    }


    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 767.98px) {

        .repair-form-header,
        .repair-form-body {
            padding: 1.2rem;
        }

        .appointment-box {
            padding: 1rem;
        }

        .appointment-header {
            align-items: flex-start;
            flex-direction: column;
            gap: .6rem;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .form-actions .btn {
                width: 100%;
            }

        .create-btn {
            min-width: 0;
        }
    }

</style>


<section class="create-repair-page py-5">

    <div class="container create-repair-container">


        <!-- =========================================
             BACK
        ========================================== -->

        <a asp-controller="Admin"
           asp-action="AppointmentDetails"
           asp-route-id="@appointment?.AppointmentId"
           class="back-link">

            <span>←</span>
            Back to Appointment

        </a>


        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="mb-4">

            <div class="page-label">
                Repair Management
            </div>

            <h1 class="page-title">
                Create Repair
            </h1>

            <p class="page-description">
                Create a repair record and assign a mechanic to the vehicle.
            </p>

        </div>


        <!-- =========================================
             MAIN CARD
        ========================================== -->

        <div class="repair-form-card">


            <!-- CARD HEADER -->

            <div class="repair-form-header">

                <h5 class="section-title">
                    New Repair Assignment
                </h5>

                <p class="section-description">
                    Review the appointment information before assigning a mechanic.
                </p>

            </div>


            <!-- CARD BODY -->

            <div class="repair-form-body">


                <!-- =================================
                     APPOINTMENT INFORMATION
                ================================== -->
                @if (appointment != null)
                {
                    <div class="appointment-box">


                        <!-- APPOINTMENT HEADER -->

                        <div class="appointment-header">

                            <h5 class="appointment-title">
                                Appointment #@appointment.AppointmentId
                            </h5>


                            <span class="appointment-badge">

                                <span class="appointment-badge-dot"></span>

                                Appointment Details

                            </span>

                        </div>


                        <div class="row g-3">


                            <!-- VEHICLE -->

                            <div class="col-md-6">

                                <div class="info-item">

                                    <div class="info-label">
                                        Vehicle
                                    </div>


                                    @if (appointment.Vehicle != null)
                                    {
                                        <div class="info-value">

                                            @appointment.Vehicle.Brand
                                            @appointment.Vehicle.Model

                                        </div>

                                        <div class="info-secondary">
                                            @appointment.Vehicle.PlateNumber
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="info-value text-muted">
                                            Vehicle unavailable
                                        </div>
                                    }

                                </div>

                            </div>


                            <!-- SERVICE TYPE -->

                            <div class="col-md-6">

                                <div class="info-item">

                                    <div class="info-label">
                                        Service Type
                                    </div>

                                    <div class="info-value">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                            appointment.ServiceType))
                                        {
                                            @appointment.ServiceType
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <!-- CUSTOMER COMPLAINT -->

                            <div class="col-12">

                                <div class="complaint-item">

                                    <div class="info-label">
                                        Customer Complaint
                                    </div>

                                    <p class="complaint-text">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                            appointment.CustomerComplaint))
                                        {
                                            @appointment.CustomerComplaint
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No customer complaint recorded.
                                            </span>
                                        }

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="appointment-error">

                        <strong>Appointment unavailable.</strong>

                        The appointment information could not be loaded.

                    </div>
                }


                <!-- =================================
                     CREATE REPAIR FORM
                ================================== -->

                <form asp-controller="Admin"
                      asp-action="CreateRepair"
                      method="post"
                      id="createRepairForm">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="appointmentId"
                           value="@appointment?.AppointmentId" />


                    <!-- =================================
                         ASSIGN MECHANIC
                    ================================== -->

                    <div class="assignment-section">

                        <div class="assignment-heading">

                            <div class="assignment-number">
                                01
                            </div>

                            <div>

                                <div class="assignment-title">
                                    Assign Mechanic
                                </div>

                                <p class="assignment-description">
                                    Select the mechanic responsible for this repair job.
                                </p>

                            </div>

                        </div>


                        <div>

                            <label for="mechanicId"
                                   class="form-label">

                                Mechanic

                                <span class="required-mark">
                                    *
                                </span>

                            </label>


                            <select name="mechanicId"
                                    id="mechanicId"
                                    asp-items="ViewBag.Mechanics"
                                    class="form-select mechanic-select"
                                    required>

                                <option value="">
                                    Select a mechanic
                                </option>

                            </select>


                            <div class="form-help">
                                The selected mechanic will be able to view and manage this repair.
                            </div>

                        </div>

                    </div>


                    <!-- =================================
                         STATUS NOTICE
                    ================================== -->

                    <div class="status-notice">

                        <div class="status-notice-icon">
                            i
                        </div>

                        <div>

                            <div class="status-notice-title">
                                Initial Repair Status
                            </div>

                            <p class="status-notice-text">

                                Once this repair is created, it will automatically
                                start with

                                <span class="assigned-status">

                                    <span class="assigned-status-dot"></span>

                                    Assigned

                                </span>

                                status. The assigned mechanic can then start the repair.

                            </p>

                        </div>

                    </div>


                    <!-- =================================
                         ACTIONS
                    ================================== -->

                    <div class="form-actions">


                        <!-- BACK -->

                        <a asp-controller="Admin"
                           asp-action="AppointmentDetails"
                           asp-route-id="@appointment?.AppointmentId"
                           class="btn btn-outline-secondary action-btn">

                            ← Back

                        </a>


                        <!-- CREATE -->

                        <button type="submit"
                                id="createRepairButton"
                                class="btn btn-primary action-btn create-btn"
                                @(appointment == null ? "disabled" : null)>

                            Create Repair & Assign Mechanic

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "createRepairForm"
                    );

                const submitButton =
                    document.getElementById(
                        "createRepairButton"
                    );


                if (!form || !submitButton) {
                    return;
                }


                form.addEventListener(
                    "submit",
                    function () {

                        // Let browser validation run first
                        if (!form.checkValidity()) {
                            return;
                        }


                        // Prevent accidental double submission
                        submitButton.disabled = true;

                        submitButton.textContent =
                            "Creating Repair...";

                    }
                );

            }
        );

    </script>

}