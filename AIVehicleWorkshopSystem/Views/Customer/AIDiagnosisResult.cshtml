@model AIVehicleWorkshopSystem.Models.AIDiagnostic

@{
    ViewData["Title"] = "AI Diagnostic Result";

    var priority = Model.Priority ?? "Not Available";
    var reviewStatus = Model.ReviewStatus ?? "Pending Review";

    var priorityClass = priority switch
    {
        "High" => "priority-high",
        "Medium" => "priority-medium",
        "Low" => "priority-low",
        _ => "priority-default"
    };

    var priorityIcon = priority switch
    {
        "High" => "bi-exclamation-triangle-fill",
        "Medium" => "bi-exclamation-circle-fill",
        "Low" => "bi-check-circle-fill",
        _ => "bi-dash-circle"
    };

    var reviewClass = reviewStatus switch
    {
        "Reviewed" => "review-confirmed",
        "Confirmed" => "review-confirmed",
        "Modified" => "review-modified",
        "Pending Review" => "review-pending",
        _ => "review-default"
    };

    var reviewIcon = reviewStatus switch
    {
        "Reviewed" => "bi-check-circle-fill",
        "Confirmed" => "bi-check-circle-fill",
        "Modified" => "bi-pencil-fill",
        "Pending Review" => "bi-clock-fill",
        _ => "bi-info-circle-fill"
    };
}

<div class="diagnostic-page">

    <div class="container py-4 py-lg-5">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->
        <div class="page-header">

            <div class="header-content">

                <div class="header-icon">
                    <i class="bi bi-clipboard2-pulse-fill"></i>
                </div>

                <div>
                    <div class="header-label">
                        AI-ASSISTED VEHICLE ANALYSIS
                    </div>

                    <h2>
                        Diagnostic Result
                    </h2>

                    <p>
                        Review your preliminary AI diagnostic recommendation
                        and mechanic verification status.
                    </p>
                </div>

            </div>


            <a asp-controller="Customer"
               asp-action="AIDiagnosis"
               class="new-diagnosis-btn">

                <i class="bi bi-plus-lg"></i>

                New Diagnosis

            </a>

        </div>


        <div class="row g-4">

            <!-- =================================================
                 MAIN CONTENT
            ================================================== -->
            <div class="col-xl-8 col-lg-8">


                <!-- =============================================
                     VEHICLE SUMMARY
                ============================================== -->
                <div class="result-card vehicle-card">

                    <div class="vehicle-information">

                        <div class="vehicle-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>

                        <div>

                            <span class="section-label">
                                VEHICLE
                            </span>

                            <h3>
                                @(Model.Vehicle != null
                                                                ? $"{Model.Vehicle.Brand} {Model.Vehicle.Model}"
                                                                : "Vehicle Unavailable")
                            </h3>

                            @if (Model.Vehicle != null)
                            {
                                <div class="vehicle-meta">

                                    <span>
                                        <i class="bi bi-credit-card-2-front"></i>
                                        @Model.Vehicle.PlateNumber
                                    </span>

                                    <span class="meta-divider"></span>

                                    <span>
                                        <i class="bi bi-calendar3"></i>
                                        @Model.Vehicle.ManufacturingYear
                                    </span>

                                </div>
                            }

                        </div>

                    </div>


                    <div class="priority-section">

                        <span class="section-label">
                            PRIORITY
                        </span>

                        <div class="priority-badge @priorityClass">

                            <i class="bi @priorityIcon"></i>

                            @priority

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     CUSTOMER SYMPTOMS
                ============================================== -->
                <div class="result-card">

                    <div class="section-heading">

                        <div class="section-heading-icon symptoms">
                            <i class="bi bi-chat-left-text-fill"></i>
                        </div>

                        <div>
                            <span class="section-number">
                                CUSTOMER INPUT
                            </span>

                            <h4>
                                Reported Symptoms
                            </h4>
                        </div>

                    </div>


                    <div class="customer-symptoms">

                        <i class="bi bi-quote quote-icon"></i>

                        <p>
                            @Model.Symptoms
                        </p>

                    </div>

                </div>


                <!-- =============================================
                     AI RECOMMENDATION
                ============================================== -->
                <div class="result-card ai-result-card">

                    <div class="ai-result-header">

                        <div class="section-heading mb-0">

                            <div class="section-heading-icon ai">
                                <i class="bi bi-stars"></i>
                            </div>

                            <div>
                                <span class="section-number">
                                    AI ANALYSIS
                                </span>

                                <h4>
                                    Diagnostic Recommendation
                                </h4>
                            </div>

                        </div>


                        <div class="ai-generated-badge">
                            <i class="bi bi-stars"></i>
                            AI Generated
                        </div>

                    </div>


                    <div class="recommendation-list">

                        <!-- POSSIBLE ISSUE -->
                        <div class="recommendation-item">

                            <div class="recommendation-icon issue">
                                <i class="bi bi-search"></i>
                            </div>

                            <div class="recommendation-content">

                                <div class="recommendation-title">
                                    Possible Issue
                                </div>

                                <p>
                                    @(Model.PossibleIssue
                                                                        ?? "No recommendation available.")
                                </p>

                            </div>

                        </div>


                        <!-- INSPECTION -->
                        <div class="recommendation-item">

                            <div class="recommendation-icon inspection">
                                <i class="bi bi-tools"></i>
                            </div>

                            <div class="recommendation-content">

                                <div class="recommendation-title">
                                    Recommended Inspection
                                </div>

                                <p>
                                    @(Model.RecommendedInspection
                                                                        ?? "No recommendation available.")
                                </p>

                            </div>

                        </div>


                        <!-- MAINTENANCE -->
                        <div class="recommendation-item">

                            <div class="recommendation-icon maintenance">
                                <i class="bi bi-wrench-adjustable-circle"></i>
                            </div>

                            <div class="recommendation-content">

                                <div class="recommendation-title">
                                    Maintenance Suggestion
                                </div>

                                <p>
                                    @(Model.MaintenanceSuggestion
                                                                        ?? "No recommendation available.")
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     MECHANIC REVIEW
                ============================================== -->
                <div class="result-card">

                    <div class="mechanic-header">

                        <div class="section-heading mb-0">

                            <div class="section-heading-icon mechanic">
                                <i class="bi bi-person-gear"></i>
                            </div>

                            <div>
                                <span class="section-number">
                                    PROFESSIONAL REVIEW
                                </span>

                                <h4>
                                    Mechanic Review
                                </h4>
                            </div>

                        </div>


                        <div class="review-badge @reviewClass">

                            <i class="bi @reviewIcon"></i>

                            @reviewStatus

                        </div>

                    </div>


                    @if (reviewStatus == "Pending Review")
                    {
                        <div class="pending-review-box">

                            <div class="pending-review-icon">
                                <i class="bi bi-hourglass-split"></i>
                            </div>

                            <div>

                                <strong>
                                    Awaiting Mechanic Review
                                </strong>

                                <p>
                                    This AI recommendation has not yet been
                                    reviewed by a mechanic. A mechanic can
                                    review the result and provide professional
                                    comments or adjustments.
                                </p>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="mechanic-comments">

                            <div class="comment-label">
                                <i class="bi bi-chat-square-check"></i>
                                Mechanic Comments
                            </div>

                            <p>
                                @(Model.MechanicComments
                                                            ?? "No mechanic comments provided.")
                        </p>

                        </div>
                                        }

                </div>


                <!-- =============================================
                     DISCLAIMER
                ============================================== -->
                <div class="disclaimer-card">

                    <div class="disclaimer-icon">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <div>

                        <strong>
                            Important Diagnostic Disclaimer
                        </strong>

                        <p>
                            This result is an AI-assisted preliminary
                            recommendation and does not confirm the actual
                            vehicle fault. A qualified mechanic should
                            physically inspect the vehicle before repair or
                            maintenance decisions are made.
                        </p>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 RIGHT SIDEBAR
            ================================================== -->
            <div class="col-xl-4 col-lg-4">


                <!-- =============================================
                     RESULT SUMMARY
                ============================================== -->
                <div class="side-card mb-4">

                    <div class="side-title">

                        <i class="bi bi-file-earmark-medical"></i>

                        Result Summary

                    </div>


                    <div class="summary-list">

                        <div class="summary-item">

                            <span>
                                Priority
                            </span>

                            <div class="mini-priority @priorityClass">
                                @priority
                            </div>

                        </div>


                        <div class="summary-item">

                            <span>
                                Mechanic Review
                            </span>

                            <strong>
                                @reviewStatus
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Generated
                            </span>

                            <strong>
                                @Model.CreatedAt.ToString("dd MMM yyyy")
                            </strong>

                        </div>


                        <div class="summary-item">

                            <span>
                                Time
                            </span>

                            <strong>
                                @Model.CreatedAt.ToString("hh:mm tt")
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     WHAT HAPPENS NEXT
                ============================================== -->
                <div class="side-card mb-4">

                    <div class="side-title">

                        <i class="bi bi-signpost-split"></i>

                        What Happens Next?

                    </div>


                    <div class="next-step-list">

                        <div class="next-step">

                            <div class="next-step-number">
                                1
                            </div>

                            <div>
                                <strong>
                                    Review the Recommendation
                                </strong>

                                <span>
                                    Read the possible issue and suggested
                                    inspection carefully.
                                </span>
                            </div>

                        </div>


                        <div class="next-step">

                            <div class="next-step-number">
                                2
                            </div>

                            <div>
                                <strong>
                                    Mechanic Verification
                                </strong>

                                <span>
                                    A mechanic may review the AI result
                                    and provide professional feedback.
                                </span>
                            </div>

                        </div>


                        <div class="next-step">

                            <div class="next-step-number">
                                3
                            </div>

                            <div>
                                <strong>
                                    Book an Inspection
                                </strong>

                                <span>
                                    If necessary, book an appointment for
                                    a physical vehicle inspection.
                                </span>
                            </div>

                        </div>

                    </div>


                    <a asp-controller="Customer"
                       asp-action="CreateAppointment"
                       class="appointment-btn">

                        <i class="bi bi-calendar-check"></i>

                        Book Appointment

                    </a>

                </div>


                <!-- =============================================
                     AI INFORMATION
                ============================================== -->
                <div class="side-card ai-info-card">

                    <div class="ai-info-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h5>
                        AI-Assisted, Not AI-Decided
                    </h5>

                    <p>
                        The AI helps identify possible causes based on
                        your symptoms. Final inspection and repair
                        decisions should be confirmed by a mechanic.
                    </p>

                </div>

            </div>

        </div>


        <!-- =====================================================
             BOTTOM ACTION
        ====================================================== -->
        <div class="bottom-actions">

            <a asp-controller="Customer"
               asp-action="AIDiagnosis"
               class="back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to AI Diagnosis

            </a>


            <span>
                Diagnostic generated
                @Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")
            </span>

        </div>

    </div>

</div>


<style>

    /* =========================================================
           PAGE
        ========================================================== */

    .diagnostic-page {
        min-height: 100vh;
        background: #f6f8fb;
    }


    /* =========================================================
           HEADER
        ========================================================== */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 54px;
        height: 54px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        color: #0d6efd;
        font-size: 23px;
        background: #eaf2ff;
        border-radius: 14px;
    }

    .header-label {
        margin-bottom: 2px;
        color: #0d6efd;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .page-header h2 {
        margin: 0 0 3px;
        color: #202833;
        font-size: 25px;
        font-weight: 750;
    }

    .page-header p {
        margin: 0;
        color: #818b96;
        font-size: 13px;
    }

    .new-diagnosis-btn {
        min-height: 42px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        padding: 0 15px;
        color: #0d6efd;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #cddfff;
        border-radius: 9px;
        transition: 0.15s ease;
        white-space: nowrap;
    }

        .new-diagnosis-btn:hover {
            color: #ffffff;
            background: #0d6efd;
            border-color: #0d6efd;
        }


    /* =========================================================
           MAIN RESULT CARDS
        ========================================================== */

    .result-card {
        margin-bottom: 20px;
        padding: 25px;
        background: #ffffff;
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.035);
    }


    /* =========================================================
           VEHICLE
        ========================================================== */

    .vehicle-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .vehicle-information {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .vehicle-icon {
        width: 52px;
        height: 52px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        color: #0d6efd;
        font-size: 21px;
        background: #eaf2ff;
        border-radius: 13px;
    }

    .section-label {
        display: block;
        margin-bottom: 3px;
        color: #939ca6;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.8px;
    }

    .vehicle-information h3 {
        margin: 0 0 5px;
        color: #2b333d;
        font-size: 20px;
        font-weight: 700;
    }

    .vehicle-meta {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #7f8994;
        font-size: 11px;
    }

        .vehicle-meta span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

    .meta-divider {
        width: 3px;
        height: 3px;
        background: #aab1b9;
        border-radius: 50%;
    }

    .priority-section {
        text-align: right;
    }


    /* =========================================================
           PRIORITY
        ========================================================== */

    .priority-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        font-size: 11px;
        font-weight: 700;
        border-radius: 8px;
    }

    .priority-high {
        color: #b42318;
        background: #fff0ef;
        border: 1px solid #ffd5d2;
    }

    .priority-medium {
        color: #8a6100;
        background: #fff7dd;
        border: 1px solid #f2df9d;
    }

    .priority-low {
        color: #157347;
        background: #edf9f2;
        border: 1px solid #ccebd9;
    }

    .priority-default {
        color: #66717d;
        background: #f0f2f4;
        border: 1px solid #dfe3e7;
    }


    /* =========================================================
           SECTION HEADINGS
        ========================================================== */

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

    .section-heading-icon {
        width: 40px;
        height: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        font-size: 16px;
        border-radius: 10px;
    }

        .section-heading-icon.symptoms {
            color: #6f42c1;
            background: #f2edfb;
        }

        .section-heading-icon.ai {
            color: #0d6efd;
            background: #eaf2ff;
        }

        .section-heading-icon.mechanic {
            color: #198754;
            background: #eaf7f0;
        }

    .section-number {
        display: block;
        margin-bottom: 1px;
        color: #939ca6;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 0.8px;
    }

    .section-heading h4 {
        margin: 0;
        color: #303944;
        font-size: 16px;
        font-weight: 700;
    }


    /* =========================================================
           CUSTOMER SYMPTOMS
        ========================================================== */

    .customer-symptoms {
        position: relative;
        padding: 18px 20px 18px 45px;
        background: #faf9fd;
        border: 1px solid #ece8f5;
        border-radius: 11px;
    }

    .quote-icon {
        position: absolute;
        top: 16px;
        left: 17px;
        color: #9d85c9;
        font-size: 17px;
    }

    .customer-symptoms p {
        margin: 0;
        color: #58616c;
        font-size: 13px;
        line-height: 1.75;
        white-space: pre-line;
    }


    /* =========================================================
           AI RESULT
        ========================================================== */

    .ai-result-card {
        border-top: 3px solid #0d6efd;
    }

    .ai-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 22px;
    }

    .ai-generated-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        color: #0d6efd;
        font-size: 9px;
        font-weight: 700;
        background: #edf4ff;
        border-radius: 7px;
        white-space: nowrap;
    }

    .recommendation-list {
        overflow: hidden;
        border: 1px solid #e8ecf1;
        border-radius: 12px;
    }

    .recommendation-item {
        display: flex;
        gap: 14px;
        padding: 19px;
        border-bottom: 1px solid #edf0f3;
    }

        .recommendation-item:last-child {
            border-bottom: none;
        }

    .recommendation-icon {
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        font-size: 15px;
        border-radius: 9px;
    }

        .recommendation-icon.issue {
            color: #dc3545;
            background: #fff0f1;
        }

        .recommendation-icon.inspection {
            color: #0d6efd;
            background: #edf4ff;
        }

        .recommendation-icon.maintenance {
            color: #198754;
            background: #edf9f2;
        }

    .recommendation-content {
        min-width: 0;
    }

    .recommendation-title {
        margin-bottom: 5px;
        color: #39434e;
        font-size: 12px;
        font-weight: 700;
    }

    .recommendation-content p {
        margin: 0;
        color: #68727e;
        font-size: 12px;
        line-height: 1.7;
        white-space: pre-line;
    }


    /* =========================================================
           MECHANIC REVIEW
        ========================================================== */

    .mechanic-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }

    .review-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        font-size: 9px;
        font-weight: 700;
        border-radius: 7px;
        white-space: nowrap;
    }

    .review-confirmed {
        color: #157347;
        background: #edf9f2;
    }

    .review-pending {
        color: #8a6100;
        background: #fff7dd;
    }

    .review-modified {
        color: #0b5ed7;
        background: #edf4ff;
    }

    .review-default {
        color: #66717d;
        background: #f0f2f4;
    }

    .pending-review-box {
        display: flex;
        gap: 14px;
        padding: 17px;
        background: #fffaf0;
        border: 1px solid #f1e3bc;
        border-radius: 11px;
    }

    .pending-review-icon {
        width: 37px;
        height: 37px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        color: #c98900;
        background: #fff0c7;
        border-radius: 9px;
    }

    .pending-review-box strong {
        display: block;
        margin-bottom: 4px;
        color: #665323;
        font-size: 12px;
    }

    .pending-review-box p {
        margin: 0;
        color: #87784e;
        font-size: 11px;
        line-height: 1.6;
    }

    .mechanic-comments {
        padding: 17px;
        background: #f4fbf7;
        border: 1px solid #d8eee1;
        border-radius: 11px;
    }

    .comment-label {
        margin-bottom: 7px;
        color: #198754;
        font-size: 11px;
        font-weight: 700;
    }

        .comment-label i {
            margin-right: 5px;
        }

    .mechanic-comments p {
        margin: 0;
        color: #596b61;
        font-size: 12px;
        line-height: 1.7;
        white-space: pre-line;
    }


    /* =========================================================
           DISCLAIMER
        ========================================================== */

    .disclaimer-card {
        display: flex;
        gap: 14px;
        padding: 17px 19px;
        background: #fffaf0;
        border: 1px solid #f0e1b7;
        border-radius: 12px;
    }

    .disclaimer-icon {
        color: #d39500;
        font-size: 18px;
        flex-shrink: 0;
    }

    .disclaimer-card strong {
        display: block;
        margin-bottom: 4px;
        color: #5f512e;
        font-size: 12px;
    }

    .disclaimer-card p {
        margin: 0;
        color: #81724b;
        font-size: 11px;
        line-height: 1.65;
    }


    /* =========================================================
           SIDEBAR
        ========================================================== */

    .side-card {
        padding: 22px;
        background: #ffffff;
        border: 1px solid #e7ebf0;
        border-radius: 15px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.035);
    }

    .side-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 18px;
        color: #343d48;
        font-size: 13px;
        font-weight: 700;
    }

        .side-title i {
            color: #0d6efd;
            font-size: 16px;
        }


    /* SUMMARY */

    .summary-list {
        border-top: 1px solid #edf0f3;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f3;
    }

        .summary-item:last-child {
            padding-bottom: 0;
