<!-- =========================================================
     SCRIPTS
========================================================== -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const symptomsInput =
                document.getElementById("symptomsInput");

            const characterCount =
                document.getElementById("characterCount");

            if (symptomsInput && characterCount) {

                function updateCharacterCount() {
                    characterCount.textContent =
                        symptomsInput.value.length;
                }

                updateCharacterCount();

                symptomsInput.addEventListener(
                    "input",
                    updateCharacterCount
                );
            }

            const diagnosticSearch = document.getElementById("diagnosticSearch");
            const clearDiagnosticSearch = document.getElementById("clearDiagnosticSearch");
            const priorityFilter = document.getElementById("priorityFilter");
            const reviewFilter = document.getElementById("reviewFilter");
            const diagnosticRows = Array.from(document.querySelectorAll(".diagnostic-history-row"));
            const diagnosticVisibleCount = document.getElementById("diagnosticVisibleCount");
            const diagnosticNoResults = document.getElementById("diagnosticNoResults");
            const historyTableWrapper = document.querySelector(".history-table-wrapper");

            function filterDiagnostics() {
                if (!diagnosticSearch || !priorityFilter || !reviewFilter) return;

                const search = diagnosticSearch.value.trim().toLowerCase();
                const priority = priorityFilter.value.toLowerCase();
                const review = reviewFilter.value.toLowerCase();
                let count = 0;

                diagnosticRows.forEach(function (row) {
                    const searchableText = [row.dataset.vehicle, row.dataset.plate, row.dataset.symptoms].join(" ").toLowerCase();
                    const matchesSearch = search === "" || searchableText.includes(search);
                    const matchesPriority = priority === "all" || row.dataset.priority === priority;
                    const matchesReview = review === "all" || row.dataset.review === review;
                    const show = matchesSearch && matchesPriority && matchesReview;
                    row.style.display = show ? "" : "none";
                    if (show) count++;
                });

                if (diagnosticVisibleCount) diagnosticVisibleCount.textContent = count;
                if (clearDiagnosticSearch) clearDiagnosticSearch.classList.toggle("show", diagnosticSearch.value.length > 0);

                if (historyTableWrapper) historyTableWrapper.style.display = count === 0 ? "none" : "";
                if (diagnosticNoResults) diagnosticNoResults.classList.toggle("show", count === 0);
            }

            if (diagnosticSearch && priorityFilter && reviewFilter) {
                diagnosticSearch.addEventListener("input", filterDiagnostics);
                priorityFilter.addEventListener("change", filterDiagnostics);
                reviewFilter.addEventListener("change", filterDiagnostics);
                if (clearDiagnosticSearch) {
                    clearDiagnosticSearch.addEventListener("click", function () {
                        diagnosticSearch.value = "";
                        diagnosticSearch.focus();
                        filterDiagnostics();
                    });
                }
                filterDiagnostics();
            }

        });
    </script>
}