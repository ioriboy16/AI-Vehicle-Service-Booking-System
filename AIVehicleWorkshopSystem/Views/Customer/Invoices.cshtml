@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("invoiceSearch");

            const clearButton =
                document.getElementById("clearInvoiceSearch");

            const statusFilter =
                document.getElementById("paymentStatusFilter");

            const rows =
                Array.from(
                    document.querySelectorAll(".invoice-row")
                );

            const visibleCount =
                document.getElementById("invoiceVisibleCount");

            const tableWrapper =
                document.getElementById("invoiceTableWrapper");

            const noResults =
                document.getElementById("invoiceNoResults");

            const resetButton =
                document.getElementById("resetInvoiceFilters");


            if (!searchInput ||
                !statusFilter ||
                rows.length === 0) {
                return;
            }


            function filterInvoices() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const status =
                    statusFilter.value
                        .trim()
                        .toLowerCase();

                let count = 0;


                rows.forEach(function (row) {

                    const searchableText = [
                        row.dataset.invoice || "",
                        row.dataset.repair || "",
                        row.dataset.vehicle || "",
                        row.dataset.plate || ""
                    ]
                    .join(" ")
                    .toLowerCase();


                    const matchesSearch =
                        search === "" ||
                        searchableText.includes(search);


                    const matchesStatus =
                        status === "all" ||
                        (row.dataset.status || "") === status;


                    const show =
                        matchesSearch &&
                        matchesStatus;


                    row.style.display =
                        show ? "" : "none";


                    if (show) {
                        count++;
                    }
                });


                if (visibleCount) {
                    visibleCount.textContent = count;
                }


                if (clearButton) {
                    clearButton.classList.toggle(
                        "show",
                        searchInput.value.length > 0
                    );
                }


                if (count === 0) {

                    if (tableWrapper) {
                        tableWrapper.style.display = "none";
                    }

                    if (noResults) {
                        noResults.classList.add("show");
                    }

                } else {

                    if (tableWrapper) {
                        tableWrapper.style.display = "";
                    }

                    if (noResults) {
                        noResults.classList.remove("show");
                    }
                }
            }


            searchInput.addEventListener(
                "input",
                filterInvoices
            );


            statusFilter.addEventListener(
                "change",
                filterInvoices
            );


            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";
                        searchInput.focus();

                        filterInvoices();
                    }
                );
            }


            if (resetButton) {

                resetButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";
                        statusFilter.value = "all";

                        filterInvoices();
                    }
                );
            }


            filterInvoices();

        });
    </script>
}
