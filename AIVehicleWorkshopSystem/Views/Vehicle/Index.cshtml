@model IEnumerable<AIVehicleWorkshopSystem.Models.Vehicle>

@{
    ViewData["Title"] = "My Vehicles";
    var vehicleCount = Model?.Count() ?? 0;
}

<div class="vehicles-page">
    <div class="container py-4 py-lg-5">

        <!-- PAGE HEADER -->
        <div class="vehicles-header">

            <div>
                <div class="page-label">
                    <i class="bi bi-car-front-fill"></i>
                    VEHICLE MANAGEMENT
                </div>

                <h2>My Vehicles</h2>

                <p>
                    View and manage all vehicles registered under your account.
                </p>
            </div>

            <a asp-controller="Vehicle"
               asp-action="Create"
               class="register-button">

                <i class="bi bi-plus-lg"></i>
                Register Vehicle

            </a>

        </div>


        <!-- SUCCESS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show
                            border-0 shadow-sm rounded-3 mb-4"
                 role="alert">

                <i class="bi bi-check-circle-fill me-2"></i>

                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>

            </div>
        }


        @if (Model == null || !Model.Any())
        {
            <!-- EMPTY STATE -->
            <div class="empty-vehicle-card">

                <div class="empty-icon">
                    <i class="bi bi-car-front"></i>
                </div>

                <h4>No vehicles registered yet</h4>

                <p>
                    Register your first vehicle to start booking
                    service appointments.
                </p>

                <a asp-controller="Vehicle"
                   asp-action="Create"
                   class="register-button">

                    <i class="bi bi-plus-lg"></i>
                    Register Vehicle

                </a>

            </div>
        }
        else
        {
            <!-- SUMMARY -->
            <div class="vehicle-summary">

                <div class="summary-left">

                    <div class="summary-icon">
                        <i class="bi bi-car-front-fill"></i>
                    </div>

                    <div>
                        <span>Registered Vehicles</span>

                        <strong>
                            @vehicleCount
                        </strong>
                    </div>

                </div>

                <p>
                    Select a vehicle below to view or update its information.
                </p>

            </div>


            <!-- VEHICLE CARDS -->
            <div class="row g-4">

                @foreach (var vehicle in Model)
                {
                    <div class="col-md-6 col-xl-4">

                        <div class="vehicle-card">

                            <!-- CARD TOP -->
                            <div class="vehicle-card-header">

                                <div class="vehicle-icon">
                                    <i class="bi bi-car-front-fill"></i>
                                </div>

                                <div class="plate-badge">
                                    @vehicle.PlateNumber
                                </div>

                            </div>


                            <!-- VEHICLE NAME -->
                            <div class="vehicle-title">

                                <span>
                                    REGISTERED VEHICLE
                                </span>

                                <h4>
                                    @vehicle.Brand @vehicle.Model
                                </h4>

                            </div>


                            <!-- VEHICLE DETAILS -->
                            <div class="vehicle-info">

                                <!-- YEAR -->
                                <div class="vehicle-info-item">

                                    <div class="info-left">
                                        <i class="bi bi-calendar3"></i>
                                        <span>Year</span>
                                    </div>

                                    <strong>
                                        @vehicle.ManufacturingYear
                                    </strong>

                                </div>


                                <!-- COLOUR -->
                                <div class="vehicle-info-item">

                                    <div class="info-left">
                                        <i class="bi bi-palette"></i>
                                        <span>Colour</span>
                                    </div>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(vehicle.Colour)
                                                                        ? "-"
                                                                        : vehicle.Colour)
                                                                                     </strong>

                                </div>


                                <!-- MILEAGE -->
                                <div class="vehicle-info-item">

                                    <div class="info-left">
                                        <i class="bi bi-speedometer2"></i>
                                        <span>Mileage</span>
                                    </div>

                                    <strong>
                                        @(vehicle.CurrentMileage.HasValue
                                                                        ? vehicle.CurrentMileage.Value.ToString("N0") + " KM"
                                                                        : "-")
                            </strong>

                                </div>

                            </div>


                            <!-- REGISTERED DATE -->
                            <div class="registered-date">

                                <i class="bi bi-calendar-check"></i>

                                <span>
                                    Registered
                                    <strong>
                                        @vehicle.CreatedAt.ToString("dd MMM yyyy")
                                    </strong>
                                </span>

                            </div>


                            <!-- PRIMARY ACTION -->
                            <a asp-controller="Vehicle"
                               asp-action="Details"
                               asp-route-id="@vehicle.VehicleId"
                               class="view-details-button">

                                <span>
                                    View Vehicle Details
                                </span>

                                <i class="bi bi-arrow-right"></i>

                            </a>


                            <!-- SECONDARY ACTIONS -->
                            <div class="vehicle-actions">

                                <a asp-controller="Vehicle"
                                   asp-action="Edit"
                                   asp-route-id="@vehicle.VehicleId"
                                   class="edit-button">

                                    <i class="bi bi-pencil-square"></i>
                                    Edit

                                </a>


                                <form asp-controller="Vehicle"
                                      asp-action="Delete"
                                      asp-route-id="@vehicle.VehicleId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="delete-button"
                                            onclick="return confirm('Are you sure you want to delete this vehicle?');">

                                        <i class="bi bi-trash3"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                        }

            </div>
        }

    </div>
</div>


<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .vehicles-page {
        min-height: 100vh;
        background: #f6f8fb;
    }

        .vehicles-page > .container {
            max-width: 1200px;
        }


    /* =====================================================
           HEADER
           ===================================================== */

    .vehicles-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 25px;
    }

    .page-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 6px;
        color: #0d6efd;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .7px;
    }

    .vehicles-header h2 {
        margin: 0 0 5px;
        color: #252d38;
        font-size: 27px;
        font-weight: 750;
    }

    .vehicles-header p {
        margin: 0;
        color: #87909b;
        font-size: 12px;
    }


    /* =====================================================
           REGISTER BUTTON
           ===================================================== */

    .register-button {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 15px;
        color: #ffffff;
        font-size: 10px;
        font-weight: 650;
        text-decoration: none;
        background: #0d6efd;
        border: 1px solid #0d6efd;
        border-radius: 9px;
        transition: .15s ease;
        white-space: nowrap;
    }

        .register-button:hover {
            color: #ffffff;
            background: #0b5ed7;
            border-color: #0b5ed7;
            transform: translateY(-1px);
        }


    /* =====================================================
           SUMMARY
           ===================================================== */

    .vehicle-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
        padding: 12px 15px;
        background: #ffffff;
        border: 1px solid #e6eaef;
        border-radius: 11px;
    }

    .summary-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .summary-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d6efd;
        background: #eaf2ff;
        border-radius: 9px;
    }

    .summary-left span {
        display: block;
        color: #8a949f;
        font-size: 9px;
    }

    .summary-left strong {
        display: block;
        color: #303945;
        font-size: 15px;
    }

    .vehicle-summary p {
        margin: 0;
        color: #929ba6;
        font-size: 10px;
    }


    /* =====================================================
           VEHICLE CARD
           ===================================================== */

    .vehicle-card {
        height: 100%;
        overflow: hidden;
        padding: 20px;
        background: #ffffff;
        border: 1px solid #e5e9ee;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .035);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .vehicle-card:hover {
            transform: translateY(-3px);
            border-color: #cfddf1;
            box-shadow: 0 10px 28px rgba(0, 0, 0, .07);
        }


    /* =====================================================
           CARD HEADER
           ===================================================== */

    .vehicle-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 17px;
    }

    .vehicle-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d6efd;
        font-size: 18px;
        background: #eaf2ff;
        border-radius: 12px;
    }

    .plate-badge {
        padding: 7px 11px;
        color: #0d6efd;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .5px;
        background: #edf4ff;
        border: 1px solid #d7e6ff;
        border-radius: 7px;
    }


    /* =====================================================
           TITLE
           ===================================================== */

    .vehicle-title {
        margin-bottom: 17px;
    }

        .vehicle-title span {
            display: block;
            margin-bottom: 3px;
            color: #9aa2ac;
            font-size: 8px;
            font-weight: 750;
            letter-spacing: .7px;
        }

        .vehicle-title h4 {
            margin: 0;
            color: #2c3540;
            font-size: 18px;
            font-weight: 750;
        }


    /* =====================================================
           VEHICLE INFO
           ===================================================== */

    .vehicle-info {
        overflow: hidden;
        margin-bottom: 13px;
        background: #fafbfc;
        border: 1px solid #e9edf1;
        border-radius: 10px;
    }

    .vehicle-info-item {
        min-height: 45px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 9px 12px;
        border-bottom: 1px solid #e9edf1;
    }

        .vehicle-info-item:last-child {
            border-bottom: 0;
        }

    .info-left {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #89939f;
    }

        .info-left i {
            width: 16px;
            color: #75818e;
            font-size: 11px;
            text-align: center;
        }

        .info-left span {
            font-size: 10px;
        }

    .vehicle-info-item strong {
        color: #404a55;
        font-size: 10px;
        font-weight: 700;
        text-align: right;
    }


    /* =====================================================
           REGISTERED DATE
           ===================================================== */

    .registered-date {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 15px;
        color: #929ba6;
        font-size: 9px;
    }

        .registered-date i {
            color: #198754;
        }

        .registered-date strong {
            color: #66717d;
            font-weight: 650;
        }


    /* =====================================================
           VIEW DETAILS
           ===================================================== */

    .view-details-button {
        width: 100%;
        min-height: 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        padding: 8px 12px;
        color: #0d6efd;
        font-size: 10px;
        font-weight: 650;
        text-decoration: none;
        background: #f5f9ff;
        border: 1px solid #d9e7ff;
        border-radius: 8px;
        transition: .15s ease;
    }

        .view-details-button:hover {
            color: #ffffff;
            background: #0d6efd;
            border-color: #0d6efd;
        }


    /* =====================================================
           ACTIONS
           ===================================================== */

    .vehicle-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
    }

        .vehicle-actions form {
            margin: 0;
        }

    .edit-button,
    .delete-button {
        width: 100%;
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 10px;
        font-size: 9px;
        font-weight: 650;
        border-radius: 8px;
        transition: .15s ease;
    }

    .edit-button {
        color: #66717d;
        text-decoration: none;
        background: #ffffff;
        border: 1px solid #dce1e6;
    }

        .edit-button:hover {
            color: #343d47;
            background: #f5f6f8;
        }

    .delete-button {
        color: #dc3545;
        background: #ffffff;
        border: 1px solid #efc0c5;
    }

        .delete-button:hover {
            color: #ffffff;
            background: #dc3545;
            border-color: #dc3545;
        }


    /* =====================================================
           EMPTY STATE
           ===================================================== */

    .empty-vehicle-card {
        padding: 65px 25px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e5e9ee;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .035);
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        color: #0d6efd;
        font-size: 25px;
        background: #eaf2ff;
        border-radius: 17px;
    }

    .empty-vehicle-card h4 {
        margin-bottom: 6px;
        color: #303945;
        font-size: 17px;
        font-weight: 750;
    }

    .empty-vehicle-card p {
        max-width: 420px;
        margin: 0 auto 20px;
        color: #929ba6;
        font-size: 11px;
        line-height: 1.6;
    }


    /* =====================================================
           DARK MODE
           ===================================================== */

    html[data-bs-theme="dark"] .vehicles-page {
        background: #101318 !important;
    }

    html[data-bs-theme="dark"] .vehicles-header h2 {
        color: #f1f5f9 !important;
    }

    html[data-bs-theme="dark"] .vehicles-header p {
        color: #8f9aaa !important;
    }

    html[data-bs-theme="dark"] .vehicle-summary,
    html[data-bs-theme="dark"] .vehicle-card,
    html[data-bs-theme="dark"] .empty-vehicle-card {
        background: #181d25 !important;
        border-color: #2b3440 !important;
        box-shadow: 0 5px 22px rgba(0, 0, 0, .18);
    }

    html[data-bs-theme="dark"] .summary-icon,
    html[data-bs-theme="dark"] .vehicle-icon,
    html[data-bs-theme="dark"] .empty-icon {
        color: #60a5fa;
        background: rgba(59, 130, 246, .14);
    }

    html[data-bs-theme="dark"] .summary-left span,
    html[data-bs-theme="dark"] .vehicle-summary p {
        color: #8793a3;
    }

    html[data-bs-theme="dark"] .summary-left strong {
        color: #e5edf6;
    }

    html[data-bs-theme="dark"] .vehicle-card:hover {
        border-color: #3b4b60 !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .28);
    }

    html[data-bs-theme="dark"] .plate-badge {
        color: #7bb3ff;
        background: rgba(59, 130, 246, .12);
        border-color: rgba(96, 165, 250, .2);
    }

    html[data-bs-theme="dark"] .vehicle-title span {
        color: #7f8a99;
    }

    html[data-bs-theme="dark"] .vehicle-title h4 {
        color: #f1f5f9;
    }

    html[data-bs-theme="dark"] .vehicle-info {
        background: #141920;
        border-color: #303946;
    }

    html[data-bs-theme="dark"] .vehicle-info-item {
        border-color: #303946;
    }

    html[data-bs-theme="dark"] .info-left {
        color: #8f9aaa;
    }

        html[data-bs-theme="dark"] .info-left i {
            color: #8793a3;
        }

    html[data-bs-theme="dark"] .vehicle-info-item strong {
        color: #dce4ee;
    }

    html[data-bs-theme="dark"] .registered-date {
        color: #7f8a99;
    }

        html[data-bs-theme="dark"] .registered-date strong {
            color: #aeb8c5;
        }

    html[data-bs-theme="dark"] .view-details-button {
        color: #60a5fa;
        background: rgba(59, 130, 246, .08);
        border-color: rgba(96, 165, 250, .22);
    }

        html[data-bs-theme="dark"] .view-details-button:hover {
            color: #ffffff;
            background: #0d6efd;
            border-color: #0d6efd;
        }

    html[data-bs-theme="dark"] .edit-button {
        color: #b7c0cc;
        background: #141920;
        border-color: #36404d;
    }

        html[data-bs-theme="dark"] .edit-button:hover {
            color: #ffffff;
            background: #252c36;
        }

    html[data-bs-theme="dark"] .delete-button {
        color: #ff7d88;
        background: #141920;
        border-color: #713a42;
    }

        html[data-bs-theme="dark"] .delete-button:hover {
            color: #ffffff;
            background: #dc3545;
            border-color: #dc3545;
        }

    html[data-bs-theme="dark"] .empty-vehicle-card h4 {
        color: #f1f5f9;
    }

    html[data-bs-theme="dark"] .empty-vehicle-card p {
        color: #8f9aaa;
    }


    /* =====================================================
           RESPONSIVE
           ===================================================== */

    @@media (max-width: 767px) {

        .vehicles-page .container {
            padding-left: 15px;
            padding-right: 15px;
        }

        .vehicles-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .register-button {
            width: 100%;
        }

        .vehicle-summary {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }
    }


    @@media (max-width: 480px) {

        .vehicles-header h2 {
            font-size: 23px;
        }

        .vehicle-card {
            padding: 17px;
        }
    }

</style>