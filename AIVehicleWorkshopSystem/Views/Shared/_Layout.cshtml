    @if (isAuthenticated)
    {
        <script>

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    const sidebar =
                        document.getElementById("appSidebar");

                    const sidebarToggle =
                        document.getElementById("sidebarToggle");

                    const mobileToggle =
                        document.getElementById("mobileSidebarToggle");

                    const overlay =
                        document.getElementById("sidebarOverlay");


                    // =============================================
                    // DESKTOP SIDEBAR
                    // =============================================

                    if (sidebarToggle) {

                        sidebarToggle.addEventListener(
                            "click",
                            function () {

                                if (window.innerWidth <= 991) {

                                    sidebar.classList.toggle(
                                        "mobile-open"
                                    );

                                    overlay.classList.toggle(
                                        "show"
                                    );

                                    return;
                                }


                                sidebar.classList.toggle(
                                    "collapsed"
                                );


                                // Remember sidebar state
                                if (
                                    sidebar.classList.contains(
                                        "collapsed"
                                    )
                                ) {

                                    localStorage.setItem(
                                        "serishSidebar",
                                        "collapsed"
                                    );

                                }
                                else {

                                    localStorage.setItem(
                                        "serishSidebar",
                                        "expanded"
                                    );

                                }

                            }
                        );

                    }


                    // =============================================
                    // RESTORE DESKTOP STATE
                    // =============================================

                    if (window.innerWidth > 991) {

                        const savedState =
                            localStorage.getItem(
                                "serishSidebar"
                            );


                        if (savedState === "collapsed") {

                            sidebar.classList.add(
                                "collapsed"
                            );

                        }

                    }


                    // =============================================
                    // MOBILE SIDEBAR
                    // =============================================

                    if (mobileToggle) {

                        mobileToggle.addEventListener(
                            "click",
                            function () {

                                sidebar.classList.add(
                                    "mobile-open"
                                );

                                overlay.classList.add(
                                    "show"
                                );

                            }
                        );

                    }


                    if (overlay) {

                        overlay.addEventListener(
                            "click",
                            function () {

                                sidebar.classList.remove(
                                    "mobile-open"
                                );

                                overlay.classList.remove(
                                    "show"
                                );

                            }
                        );

                    }


                    // Close mobile sidebar only after selecting
// a navigation link.
//
// Do NOT close it when the Notifications button
// is pressed because the notification panel
// lives inside the sidebar.
document
    .querySelectorAll(
        ".sidebar-link"
    )
    .forEach(function (link) {

        link.addEventListener(
            "click",
            function () {

                if (
                    window.innerWidth <= 991 &&
                    link.id !== "notificationButton"
                ) {

                    sidebar.classList.remove(
                        "mobile-open"
                    );

                    overlay.classList.remove(
                        "show"
                    );

                }

            }
        );

    });


                    // =============================================
                    // WINDOW RESIZE
                    // =============================================

                    window.addEventListener(
                        "resize",
                        function () {

                            if (
                                window.innerWidth > 991
                            ) {

                                sidebar.classList.remove(
                                    "mobile-open"
                                );

                                overlay.classList.remove(
                                    "show"
                                );

                            }

                        }
                    );

                                // =============================================
            // THEME
            // =============================================

            const themeButtons =
                document.querySelectorAll(
                    ".theme-option"
                );

            const systemTheme =
                window.matchMedia(
                    "(prefers-color-scheme: dark)"
                );


            function resolveTheme(theme) {

                if (theme === "system") {

                    return systemTheme.matches
                        ? "dark"
                        : "light";

                }

                return theme;
            }


            function applyTheme(theme) {

                const resolvedTheme =
                    resolveTheme(theme);


                document.documentElement.setAttribute(
                    "data-bs-theme",
                    resolvedTheme
                );


                document.documentElement.setAttribute(
                    "data-serish-theme",
                    theme
                );


                localStorage.setItem(
                    "serishTheme",
                    theme
                );


                themeButtons.forEach(
                    function (button) {

                        button.classList.toggle(
                            "active",
                            button.dataset.theme === theme
                        );

                    }
                );

            }


            const savedTheme =
                localStorage.getItem(
                    "serishTheme"
                ) || "system";


            applyTheme(savedTheme);


            themeButtons.forEach(
                function (button) {

                    button.addEventListener(
                        "click",
                        function () {

                            applyTheme(
                                button.dataset.theme
                            );

                        }
                    );

                }
            );


            // If user selected System,
            // automatically follow Windows / phone changes
            systemTheme.addEventListener(
                "change",
                function () {

                    const currentTheme =
                        localStorage.getItem(
                            "serishTheme"
                        ) || "system";


                    if (currentTheme === "system") {

                        applyTheme("system");

                    }

                }
            );

                }
            );

        </script>
    }

    @if (isAuthenticated)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                // =====================================================
                // NOTIFICATION SYSTEM
                // =====================================================

                const notificationButton =
                    document.getElementById("notificationButton");

                const notificationPanel =
                    document.getElementById("notificationPanel");

                const notificationBadge =
                    document.getElementById("notificationBadge");

                const notificationList =
                    document.getElementById("notificationList");

                const notificationSummary =
                    document.getElementById("notificationSummary");

                const markAllButton =
                    document.getElementById("markAllNotificationsRead");

                                // =====================================================
            // WEB PUSH NOTIFICATIONS
            // =====================================================

            const enablePushButton =
                document.getElementById("enablePushNotifications");

            const pushNotificationStatus =
                document.getElementById("pushNotificationStatus");


            // Convert VAPID Base64 URL key to Uint8Array
            function urlBase64ToUint8Array(base64String) {

                const padding =
                    "=".repeat((4 - base64String.length % 4) % 4);

                const base64 =
                    (base64String + padding)
                        .replace(/-/g, "+")
                        .replace(/_/g, "/");

                const rawData =
                    window.atob(base64);

                return Uint8Array.from(
                    [...rawData].map(
                        character => character.charCodeAt(0)
                    )
                );
            }


            // Update button based on current permission
            function updatePushButtonState() {

                if (!enablePushButton) {
                    return;
                }


                // Browser does not support Web Push
                if (
                    !("serviceWorker" in navigator) ||
                    !("PushManager" in window) ||
                    !("Notification" in window)
                ) {

                    enablePushButton.disabled = true;

                    enablePushButton.innerHTML =
                        '<i class="bi bi-x-circle me-1"></i>' +
                        'Notifications Not Supported';

                    if (pushNotificationStatus) {
                        pushNotificationStatus.textContent =
                            "Push notifications are not supported on this device.";
                    }

                    return;
                }


                // Permission already denied
                if (Notification.permission === "denied") {

                    enablePushButton.disabled = true;

                    enablePushButton.innerHTML =
                        '<i class="bi bi-bell-slash-fill me-1"></i>' +
                        'Notifications Blocked';

                    if (pushNotificationStatus) {
                        pushNotificationStatus.textContent =
                            "Notifications are blocked in your device settings.";
                    }

                    return;
                }


                // Permission already granted
                if (Notification.permission === "granted") {

                    enablePushButton.innerHTML =
                        '<i class="bi bi-check-circle-fill me-1"></i>' +
                        'Notifications Enabled';

                    if (pushNotificationStatus) {
                        pushNotificationStatus.textContent =
                            "Push notifications are allowed on this device.";
                    }

                    return;
                }


                // Permission not requested yet
                enablePushButton.innerHTML =
                    '<i class="bi bi-bell-fill me-1"></i>' +
                    'Enable Phone Notifications';

                if (pushNotificationStatus) {
                    pushNotificationStatus.textContent =
                        "Get repair and service updates on this device.";
                }
            }


            // Register this device with the server
            async function enablePushNotifications() {

                if (!enablePushButton) {
                    return;
                }


                if (
                    !("serviceWorker" in navigator) ||
                    !("PushManager" in window) ||
                    !("Notification" in window)
                ) {

                    updatePushButtonState();
                    return;
                }


                try {

                    enablePushButton.disabled = true;

                    if (pushNotificationStatus) {
                        pushNotificationStatus.textContent =
                            "Setting up notifications...";
                    }


                    // Must be triggered from the button click.
                    const permission =
                        await Notification.requestPermission();


                    if (permission !== "granted") {

                        updatePushButtonState();

                        enablePushButton.disabled =
                            permission === "denied";

                        return;
                    }


                    // Wait until our existing PWA service worker is ready.
                    const registration =
                        await navigator.serviceWorker.ready;


                    // Get PUBLIC VAPID key from ASP.NET.
                    const keyResponse =
                        await fetch(
                            "/Notification/GetVapidPublicKey",
                            {
                                method: "GET",
                                credentials: "same-origin"
                            }
                        );


                    if (!keyResponse.ok) {

                        throw new Error(
                            "Unable to obtain the VAPID public key."
                        );
                    }


                    const keyData =
                        await keyResponse.json();


                    if (!keyData.publicKey) {

                        throw new Error(
                            "VAPID public key was not returned."
                        );
                    }


                    // Check whether this browser already has
                    // a push subscription.
                    let subscription =
                        await registration.pushManager
                            .getSubscription();


                    if (!subscription) {

                        subscription =
                            await registration.pushManager.subscribe({
                                userVisibleOnly: true,

                                applicationServerKey:
                                    urlBase64ToUint8Array(
                                        keyData.publicKey
                                    )
                            });
                    }


                    // Convert browser PushSubscription
                    // into normal JSON.
                    const subscriptionJson =
                        subscription.toJSON();


                    if (
                        !subscriptionJson.endpoint ||
                        !subscriptionJson.keys ||
                        !subscriptionJson.keys.p256dh ||
                        !subscriptionJson.keys.auth
                    ) {

                        throw new Error(
                            "Browser returned an invalid push subscription."
                        );
                    }


                    // Save subscription in our database.
                    const saveResponse =
                        await fetch(
                            "/Notification/Subscribe",
                            {
                                method: "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json"
                                },

                                credentials: "same-origin",

                                body: JSON.stringify({
                                    endpoint:
                                        subscriptionJson.endpoint,

                                    keys: {
                                        p256dh:
                                            subscriptionJson.keys.p256dh,

                                        auth:
                                            subscriptionJson.keys.auth
                                    }
                                })
                            }
                        );


                    if (!saveResponse.ok) {

                        throw new Error(
                            "Unable to save the push subscription."
                        );
                    }


                    enablePushButton.disabled = false;

                    enablePushButton.innerHTML =
                        '<i class="bi bi-check-circle-fill me-1"></i>' +
                        'Notifications Enabled';


                    if (pushNotificationStatus) {

                        pushNotificationStatus.textContent =
                            "This device is registered for Serish AutoCare notifications.";
                    }


                    console.log(
                        "Serish AutoCare push notifications enabled."
                    );

                }
                catch (error) {

                    console.error(
                        "Unable to enable push notifications:",
                        error
                    );


                    enablePushButton.disabled = false;


                    if (pushNotificationStatus) {

                        pushNotificationStatus.textContent =
                            "Unable to enable notifications. Please try again.";
                    }
                }
            }


            // User gesture is important for notification permission.
            if (enablePushButton) {

                enablePushButton.addEventListener(
                    "click",
                    enablePushNotifications
                );
            }


            updatePushButtonState();


                if (!notificationButton ||
                    !notificationPanel ||
                    !notificationBadge ||
                    !notificationList) {

                    return;
                }


                // =====================================================
                // HTML ESCAPE
                // =====================================================

                function escapeHtml(value) {

                    if (!value) {
                        return "";
                    }

                    const div = document.createElement("div");

                    div.textContent = value;

                    return div.innerHTML;
                }


                // =====================================================
                // NOTIFICATION ICON
                // =====================================================

                function getNotificationIcon(type) {

                    const normalizedType =
                        (type || "").toLowerCase();

                    if (normalizedType.includes("repair")) {
                        return "bi-tools";
                    }

                    if (normalizedType.includes("appointment")) {
                        return "bi-calendar-check";
                    }

                    if (normalizedType.includes("invoice") ||
                        normalizedType.includes("payment")) {
                        return "bi-receipt";
                    }

                    if (normalizedType.includes("chat") ||
                        normalizedType.includes("message") ||
                        normalizedType.includes("support")) {
                        return "bi-chat-left-text";
                    }

                    if (normalizedType.includes("ai") ||
                        normalizedType.includes("diagnostic")) {
                        return "bi-stars";
                    }

                    return "bi-bell";
                }


                // =====================================================
                // RELATIVE TIME
                // =====================================================

                function getRelativeTime(dateValue) {

                    const date = new Date(dateValue);

                    if (Number.isNaN(date.getTime())) {
                        return "";
                    }

                    const now = new Date();

                    const seconds =
                        Math.floor((now - date) / 1000);


                    if (seconds < 60) {
                        return "Just now";
                    }


                    const minutes =
                        Math.floor(seconds / 60);

                    if (minutes < 60) {
                        return `${minutes} min ago`;
                    }


                    const hours =
                        Math.floor(minutes / 60);

                    if (hours < 24) {
                        return `${hours} hr ago`;
                    }


                    const days =
                        Math.floor(hours / 24);

                    if (days < 7) {
                        return `${days} day${days > 1 ? "s" : ""} ago`;
                    }


                    return date.toLocaleDateString();
                }


                // =====================================================
                // BADGE
                // =====================================================

                function updateNotificationBadge(count) {

                    const unreadCount =
                        Number(count) || 0;


                    if (unreadCount <= 0) {

                        notificationBadge.textContent = "0";

                        notificationBadge.classList.add("d-none");

                        if (notificationSummary) {
                            notificationSummary.textContent =
                                "You're all caught up";
                        }

                        return;
                    }


                    notificationBadge.textContent =
                        unreadCount > 99
                            ? "99+"
                            : unreadCount;


                    notificationBadge.classList.remove("d-none");


                    if (notificationSummary) {

                        notificationSummary.textContent =
                            `${unreadCount} unread notification${unreadCount === 1 ? "" : "s"}`;
                    }
                }


                // =====================================================
                // CREATE NOTIFICATION HTML
                // =====================================================

                function createNotificationItem(notification) {

                    const item =
                        document.createElement("div");


                    item.className =
                        "notification-item" +
                        (notification.isRead ? "" : " unread");


                    item.dataset.notificationId =
                        notification.notificationId;


                    if (notification.relatedUrl) {

                        item.dataset.relatedUrl =
                            notification.relatedUrl;
                    }


                    const icon =
                        getNotificationIcon(notification.type);


                    item.innerHTML = `
                        <div class="notification-item-icon">
                            <i class="bi ${icon}"></i>
                        </div>

                        <div class="notification-item-content">

                            <div class="notification-item-title">

                                <span>
                                    ${escapeHtml(notification.title)}
                                </span>

                                ${
                                    notification.isRead
                                        ? ""
                                        : '<span class="notification-unread-dot"></span>'
                                }

                            </div>

                            <div class="notification-item-message">
                                ${escapeHtml(notification.message)}
                            </div>

                            <div class="notification-item-time">
                                ${escapeHtml(
                                    getRelativeTime(notification.createdAt)
                                )}
                            </div>

                        </div>
                    `;


                    item.addEventListener(
                        "click",
                        async function () {

                            await openNotification(
                                notification.notificationId,
                                notification.relatedUrl
                            );
                        }
                    );


                    return item;
                }


                // =====================================================
                // RENDER LIST
                // =====================================================

                function renderNotifications(notifications) {

                    notificationList.innerHTML = "";


                    if (!notifications ||
                        notifications.length === 0) {

                        notificationList.innerHTML = `
                            <div class="notification-empty">
                                <i class="bi bi-bell"></i>
                                <span>No notifications yet</span>
                            </div>
                        `;

                        return;
                    }


                    notifications.forEach(
                        function (notification) {

                            notificationList.appendChild(
                                createNotificationItem(notification)
                            );
                        }
                    );
                }


                // =====================================================
                // LOAD FROM DATABASE
                // =====================================================

                async function loadNotifications() {

                    try {

                        const response =
                            await fetch(
                                "/Notification/GetNotifications",
                                {
                                    method: "GET",
                                    credentials: "same-origin"
                                }
                            );


                        if (!response.ok) {
                            return;
                        }


                        const data =
                            await response.json();


                        updateNotificationBadge(
                            data.unreadCount
                        );


                        renderNotifications(
                            data.notifications
                        );

                    }
                    catch (error) {

                        console.error(
                            "Unable to load notifications:",
                            error
                        );
                    }
                }


                // =====================================================
                // ANTI-FORGERY TOKEN
                // =====================================================

                            function getAntiForgeryToken() {

                const token =
                    document.querySelector(
                        '#notificationAntiForgeryForm input[name="__RequestVerificationToken"]'
                    );

                return token
                    ? token.value
                    : "";
            }


                // =====================================================
                // OPEN + MARK ONE AS READ
                // =====================================================

                async function openNotification(
                    notificationId,
                    relatedUrl) {

                    try {

                        const formData =
                            new FormData();


                        formData.append(
                            "notificationId",
                            notificationId
                        );


                        const response =
                            await fetch(
                                "/Notification/MarkAsRead",
                                {
                                    method: "POST",

                                                headers: {
                "X-CSRF-TOKEN": getAntiForgeryToken(),
                "X-Requested-With": "XMLHttpRequest"
            },

                                    body: formData,

                                    credentials: "same-origin"
                                }
                            );


                        if (!response.ok) {
                            return;
                        }


                        if (relatedUrl) {

                            window.location.href =
                                relatedUrl;

                            return;
                        }


                        await loadNotifications();

                    }
                    catch (error) {

                        console.error(
                            "Unable to mark notification as read:",
                            error
                        );
                    }
                }


                // =====================================================
                // MARK ALL AS READ
                // =====================================================

                if (markAllButton) {

                    markAllButton.addEventListener(
                        "click",
                        async function (event) {

                            event.stopPropagation();


                            try {

                                const response =
                                    await fetch(
                                        "/Notification/MarkAllAsRead",
                                        {
                                            method: "POST",

                                                      headers: {
                "X-CSRF-TOKEN": getAntiForgeryToken(),
                "X-Requested-With": "XMLHttpRequest"
            },

                                            credentials: "same-origin"
                                        }
                                    );


                                if (response.ok) {

                                    await loadNotifications();
                                }

                            }
                            catch (error) {

                                console.error(
                                    "Unable to mark all notifications as read:",
                                    error
                                );
                            }
                        }
                    );
                }


                // =====================================================
                // OPEN / CLOSE PANEL
                // =====================================================

                notificationButton.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();

                        notificationPanel.classList.toggle(
                            "show"
                        );


                        if (
                            notificationPanel.classList.contains(
                                "show"
                            )
                        ) {

                            loadNotifications();
                        }
                    }
                );


                notificationPanel.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();
                    }
                );


                document.addEventListener(
                    "click",
                    function () {

                        notificationPanel.classList.remove(
                            "show"
                        );
                    }
                );


                // =====================================================
                // SIGNALR REAL-TIME
                // =====================================================

                if (typeof signalR !== "undefined") {

                    const notificationConnection =
                        new signalR.HubConnectionBuilder()
                            .withUrl("/notificationHub")
                            .withAutomaticReconnect()
                            .build();


                    notificationConnection.on(
                        "ReceiveNotification",
                        function (notification) {

                            updateNotificationBadge(
                                notification.unreadCount
                            );


                            // Refresh list from database so the
                            // database remains the source of truth.
                            loadNotifications();
                        }
                    );


                    notificationConnection.on(
                        "NotificationCountUpdated",
                        function (unreadCount) {

                            updateNotificationBadge(
                                unreadCount
                            );
                        }
                    );


                    async function startNotificationHub() {

                        try {

                            await notificationConnection.start();

                            console.log(
                                "Notification SignalR connected."
                            );

                        }
                        catch (error) {

                            console.error(
                                "Notification SignalR connection failed:",
                                error
                            );


                            setTimeout(
                                startNotificationHub,
                                5000
                            );
                        }
                    }


                    notificationConnection.onreconnected(
                        function () {

                            loadNotifications();
                        }
                    );


                    startNotificationHub();
                }


                // =====================================================
                // INITIAL LOAD
                // =====================================================

                loadNotifications();

            });
        </script>
    }

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>

</html>