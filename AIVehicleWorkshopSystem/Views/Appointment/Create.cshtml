@model AIVehicleWorkshopSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
}

<style>
    .appointment-page {
        min-height: calc(100vh - 70px);
        background: #f6f8fb;
        padding: 28px 0 40px;
    }

    .appointment-container {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* HEADER */
    .appointment-header {
        margin-bottom: 20px;
    }

    .appointment-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #0d6efd;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .appointment-title {
        font-size: clamp(1.65rem, 3vw, 2.2rem);
        font-weight: 750;
        color: #172033;
        margin-bottom: 5px;
    }

    .appointment-subtitle {
        color: #718096;
        margin: 0;
        font-size: .95rem;
    }

    /* MAIN CARD */
    .booking-card {
        background: #ffffff;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(31, 45, 61, .06);
        overflow: hidden;
    }

    .booking-body {
        padding: 26px 28px 22px;
    }

    /* SECTION */
    .form-section {
        height: 100%;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 18px;
    }

    .section-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 11px;
        background: #edf5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

    .section-title {
        color: #1f2937;
        font-size: .95rem;
        font-weight: 700;
        margin: 0;
    }

    .section-description {
        color: #8a94a6;
        font-size: .76rem;
        margin: 2px 0 0;
    }

    .form-divider {
        border-left: 1px solid #e9edf3;
    }

    /* FORM CONTROLS */
    .appointment-page .form-label {
        color: #374151;
        font-size: .85rem;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .appointment-page .form-control,
    .appointment-page .form-select {
        min-height: 45px;
        border: 1px solid #dfe5ec;
        border-radius: 10px;
        background-color: #fff;
        color: #253044;
        font-size: .9rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .appointment-page .form-control:focus,
        .appointment-page .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .10);
        }

    .appointment-page textarea.form-control {
        min-height: 88px;
        resize: vertical;
    }

    .appointment-page .form-text {
        color: #98a1b2;
        font-size: .73rem;
        margin-top: 6px;
    }

    .field-group {
        margin-bottom: 18px;
    }

    /* COMPLAINT */
    .complaint-section {
        border-top: 1px solid #edf0f4;
        margin-top: 22px;
        padding-top: 22px;
    }

    .complaint-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 10px;
    }

    .complaint-title {
        color: #374151;
        font-size: .86rem;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .complaint-help {
        color: #98a1b2;
        font-size: .75rem;
        margin: 0;
    }

    .optional-badge {
        background: #f1f4f8;
        color: #7a8495;
        border-radius: 20px;
        padding: 4px 10px;
        font-size: .68rem;
        font-weight: 600;
        white-space: nowrap;
    }

    /* FOOTER */
    .booking-footer {
        background: #fafbfd;
        border-top: 1px solid #edf0f4;
        padding: 16px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .request-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .request-icon {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        border-radius: 50%;
        background: #edf5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .85rem;
    }

    .request-title {
        color: #374151;
        font-size: .8rem;
        font-weight: 700;
        margin-bottom: 1px;
    }

    .request-text {
        color: #8b95a5;
        font-size: .72rem;
        line-height: 1.35;
    }

    .booking-actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

        .booking-actions .btn {
            border-radius: 9px;
            font-size: .84rem;
            font-weight: 600;
            padding: 9px 18px;
        }

    .book-btn {
        min-width: 155px;
    }

    /* VALIDATION */
    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        margin-bottom: 20px;
        font-size: .85rem;
        border-radius: 10px;
    }

    /* NO VEHICLE */
    .no-vehicle-card {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(31, 45, 61, .06);
        text-align: center;
        padding: 55px 30px;
    }

    .no-vehicle-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 18px;
        border-radius: 20px;
        background: #edf5ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    /* RESPONSIVE */
    @@media (max-width: 767.98px) {
        .appointment-page {
            padding: 20px 0 30px;
        }

        .appointment-container {
            padding-left: 4px;
            padding-right: 4px;
        }

        .booking-body {
            padding: 22px 18px;
        }

        .form-divider {
            border-left: 0;
            border-top: 1px solid #edf0f4;
            padding-top: 22px;
            margin-top: 4px;
        }

        .booking-footer {
            padding: 17px 18px;
            flex-direction: column;
            align-items: stretch;
        }

        .booking-actions {
            width: 100%;
        }

            .booking-actions .btn {
                flex: 1;
            }

        .complaint-header {
            gap: 10px;
        }
    }

    @@media (max-width: 575.98px) {
        .appointment-title {
            font-size: 1.55rem;
        }

        .booking-card {
            border-radius: 14px;
        }

        .booking-actions {
            flex-direction: column-reverse;
        }

        .book-btn {
            width: 100%;
        }

    }
        /* =====================================================
       DARK MODE
       ===================================================== */

    [data-bs-theme="dark"] .appointment-page {
            background: #0f1115;
        }

        [data-theme="dark"] .appointment-title {
            color: #f8fafc;
        }

        [data-theme="dark"] .appointment-subtitle {
            color: #94a3b8;
        }
        /* MAIN CARD */
        [data-theme="dark"] .booking-card {
            background: #17191e;
            border-color: #2b2f36;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .22);
        }
        /* SECTION */
        [data-theme="dark"] .section-title {
            color: #f1f5f9;
        }

        [data-theme="dark"] .section-description {
            color: #94a3b8;
        }

        [data-theme="dark"] .section-icon {
            background: rgba(13, 110, 253, .14);
            color: #60a5fa;
        }

        [data-theme="dark"] .form-divider {
            border-color: #2b2f36;
        }
        /* LABELS */
        [data-theme="dark"] .appointment-page .form-label {
            color: #e5e7eb;
        }
        /* INPUTS */
        [data-theme="dark"] .appointment-page .form-control,
        [data-theme="dark"] .appointment-page .form-select {
            background-color: #111318;
            border-color: #343943;
            color: #f1f5f9;
        }

            [data-theme="dark"] .appointment-page .form-control:focus,
            [data-theme="dark"] .appointment-page .form-select:focus {
                background-color: #111318;
                color: #ffffff;
                border-color: #3b82f6;
                box-shadow: 0 0 0 .2rem rgba(59, 130, 246, .12);
            }
            /* PLACEHOLDER */
            [data-theme="dark"] .appointment-page .form-control::placeholder {
                color: #6b7280;
            }
            /* SELECT OPTIONS */
            [data-theme="dark"] .appointment-page .form-select option {
                background-color: #17191e;
                color: #f1f5f9;
            }
        /* DATE / TIME ICON */
        [data-theme="dark"] .appointment-page input[type="date"],
        [data-theme="dark"] .appointment-page input[type="time"] {
            color-scheme: dark;
        }
        /* HELPER TEXT */
        [data-theme="dark"] .appointment-page .form-text,
        [data-theme="dark"] .complaint-help {
            color: #7f8a9a;
        }
        /* COMPLAINT */
        [data-theme="dark"] .complaint-section {
            border-color: #2b2f36;
        }

        [data-theme="dark"] .complaint-title {
            color: #e5e7eb;
        }

        [data-theme="dark"] .optional-badge {
            background: #252932;
            color: #aab3c2;
        }
        /* FOOTER */
        [data-theme="dark"] .booking-footer {
            background: #14161b;
            border-color: #2b2f36;
        }

        [data-theme="dark"] .request-icon {
            background: rgba(13, 110, 253, .14);
            color: #60a5fa;
        }

        [data-theme="dark"] .request-title {
            color: #e5e7eb;
        }

        [data-theme="dark"] .request-text {
            color: #8b95a5;
        }
        /* CANCEL BUTTON */
        [data-theme="dark"] .booking-actions .btn-outline-secondary {
            color: #cbd5e1;
            border-color: #475569;
        }

            [data-theme="dark"] .booking-actions .btn-outline-secondary:hover {
                background: #2b3038;
                color: #ffffff;
                border-color: #64748b;
            }
        /* NO VEHICLE */
        [data-theme="dark"] .no-vehicle-card {
            background: #17191e;
            border-color: #2b2f36;
            color: #f1f5f9;
            box-shadow: 0 8px 30px rgba(0, 0, 0, .22);
        }

        [data-theme="dark"] .no-vehicle-icon {
            background: rgba(13, 110, 253, .14);
        }

        [data-theme="dark"] .no-vehicle-card .text-muted {
            color: #94a3b8 !important;
        }
        /* MOBILE DIVIDER */
        @@media (max-width: 767.98px) {
            [data-theme="dark"] .form-divider {
                border-top-color: #2b2f36;
            }
        }

    /* =====================================================
       FINAL DARK MODE OVERRIDE
       ===================================================== */

    html[data-bs-theme="dark"] .booking-card {
        background: #171b22 !important;
        border-color: #2b3440 !important;
        box-shadow: 0 8px 30px rgba(0, 0, 0, .22) !important;
    }

    html[data-bs-theme="dark"] .booking-body {
        background: #171b22 !important;
    }

    html[data-bs-theme="dark"] .section-title {
        color: #f1f5f9 !important;
    }

    html[data-bs-theme="dark"] .section-description {
        color: #8f9bad !important;
    }

    html[data-bs-theme="dark"] .section-icon {
        background: rgba(13, 110, 253, .14) !important;
        color: #60a5fa !important;
    }

    html[data-bs-theme="dark"] .form-divider {
        border-color: #303946 !important;
    }

    html[data-bs-theme="dark"] .appointment-page .form-label {
        color: #e2e8f0 !important;
    }

    html[data-bs-theme="dark"] .appointment-page .form-control,
    html[data-bs-theme="dark"] .appointment-page .form-select {
        background-color: #10151c !important;
        border-color: #36404d !important;
        color: #e5edf6 !important;
    }

        html[data-bs-theme="dark"] .appointment-page .form-control:focus,
        html[data-bs-theme="dark"] .appointment-page .form-select:focus {
            background-color: #10151c !important;
            border-color: #3b82f6 !important;
            color: #ffffff !important;
            box-shadow: 0 0 0 .2rem rgba(59, 130, 246, .12) !important;
        }

        html[data-bs-theme="dark"] .appointment-page .form-control::placeholder {
            color: #6f7b8b !important;
        }

        html[data-bs-theme="dark"] .appointment-page .form-select option {
            background: #171b22 !important;
            color: #e5edf6 !important;
        }

    html[data-bs-theme="dark"] .appointment-page input[type="date"],
    html[data-bs-theme="dark"] .appointment-page input[type="time"] {
        color-scheme: dark;
    }

    html[data-bs-theme="dark"] .appointment-page .form-text {
        color: #7f8b9b !important;
    }

    html[data-bs-theme="dark"] .complaint-section {
        border-color: #303946 !important;
    }

    html[data-bs-theme="dark"] .complaint-title {
        color: #e2e8f0 !important;
    }

    html[data-bs-theme="dark"] .complaint-help {
        color: #7f8b9b !important;
    }

    html[data-bs-theme="dark"] .optional-badge {
        background: #252c36 !important;
        color: #a7b2c1 !important;
    }

    html[data-bs-theme="dark"] .booking-footer {
        background: #12171e !important;
        border-color: #303946 !important;
    }

    html[data-bs-theme="dark"] .request-icon {
        background: rgba(13, 110, 253, .14) !important;
        color: #60a5fa !important;
    }

    html[data-bs-theme="dark"] .request-title {
        color: #e2e8f0 !important;
    }

    html[data-bs-theme="dark"] .request-text {
        color: #8491a3 !important;
    }

    html[data-bs-theme="dark"] .booking-actions .btn-outline-secondary {
        color: #cbd5e1 !important;
        border-color: #475569 !important;
    }

        html[data-bs-theme="dark"] .booking-actions .btn-outline-secondary:hover {
            background: #29313b !important;
            border-color: #64748b !important;
            color: #ffffff !important;
        }
</style>

<section class="appointment-page">
    <div class="container">
        <div class="appointment-container">

            <!-- PAGE HEADER -->
            <div class="appointment-header">

                <div class="appointment-eyebrow">
                    <i class="bi bi-calendar2-check"></i>
                    Service Appointment
                </div>

                <h1 class="appointment-title">
                    Book Your Service Appointment
                </h1>

                <p class="appointment-subtitle">
                    Select your vehicle, service type and preferred schedule.
                </p>

            </div>

            @if (ViewBag.HasVehicles == false)
            {
                <!-- NO VEHICLE -->
                <div class="no-vehicle-card">

                    <div class="no-vehicle-icon">
                        🚗
                    </div>

                    <h4 class="fw-bold mb-2">
                        No Vehicle Registered
                    </h4>

                    <p class="text-muted mb-4">
                        Register your vehicle before booking a service appointment.
                    </p>

                    <a asp-controller="Vehicle"
                       asp-action="Create"
                       class="btn btn-primary px-4 py-2 rounded-3">

                        <i class="bi bi-plus-lg me-1"></i>
                        Register Vehicle

                    </a>

                </div>
            }
            else
            {
                <!-- APPOINTMENT FORM -->
                <form asp-controller="Appointment"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="booking-card">

                        <div class="booking-body">

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger">
                            </div>

                            <div class="row g-0">

                                <!-- LEFT SIDE -->
                                <div class="col-md-6 pe-md-4">

                                    <div class="form-section">

                                        <div class="section-heading">

                                            <div class="section-icon">
                                                <i class="bi bi-car-front"></i>
                                            </div>

                                            <div>
                                                <h2 class="section-title">
                                                    Vehicle & Service
                                                </h2>

                                                <p class="section-description">
                                                    Choose the vehicle and required service.
                                                </p>
                                            </div>

                                        </div>

                                        <!-- VEHICLE -->
                                        <div class="field-group">

                                            <label asp-for="VehicleId"
                                                   class="form-label">
                                                Select Vehicle
                                            </label>

                                            <select asp-for="VehicleId"
                                                    asp-items="ViewBag.Vehicles"
                                                    class="form-select">

                                                <option value="">
                                                    -- Select your vehicle --
                                                </option>

                                            </select>

                                            <span asp-validation-for="VehicleId"
                                                  class="text-danger small">
                                            </span>

                                            <div class="form-text">
                                                Only vehicles registered under your account are shown.
                                            </div>

                                        </div>

                                        <!-- SERVICE TYPE -->
                                        <div class="field-group mb-md-0">

                                            <label asp-for="ServiceType"
                                                   class="form-label">
                                                Service Type
                                            </label>

                                            <select asp-for="ServiceType"
                                                    class="form-select">

                                                <option value="">
                                                    -- Select service type --
                                                </option>

                                                <option value="Regular Service">
                                                    Regular Service
                                                </option>

                                                <option value="Oil Change">
                                                    Oil Change
                                                </option>

                                                <option value="Brake Service">
                                                    Brake Service
                                                </option>

                                                <option value="Air Conditioning Service">
                                                    Air Conditioning Service
                                                </option>

                                                <option value="Tyre Service">
                                                    Tyre Service
                                                </option>

                                                <option value="Battery Service">
                                                    Battery Service
                                                </option>

                                                <option value="Engine Diagnosis">
                                                    Engine Diagnosis
                                                </option>

                                                <option value="General Inspection">
                                                    General Inspection
                                                </option>

                                                <option value="Other">
                                                    Other
                                                </option>

                                            </select>

                                            <span asp-validation-for="ServiceType"
                                                  class="text-danger small">
                                            </span>

                                        </div>

                                    </div>

                                </div>

                                <!-- RIGHT SIDE -->
                                <div class="col-md-6 ps-md-4 form-divider">

                                    <div class="form-section">

                                        <div class="section-heading">

                                            <div class="section-icon">
                                                <i class="bi bi-clock"></i>
                                            </div>

                                            <div>
                                                <h2 class="section-title">
                                                    Preferred Schedule
                                                </h2>

                                                <p class="section-description">
                                                    Select your preferred appointment date and time.
                                                </p>
                                            </div>

                                        </div>

                                        <!-- DATE -->
                                        <div class="field-group">

                                            <label asp-for="AppointmentDate"
                                                   class="form-label">
                                                Appointment Date
                                            </label>

                                            <input asp-for="AppointmentDate"
                                                   type="date"
                                                   class="form-control"
                                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />

                                            <span asp-validation-for="AppointmentDate"
                                                  class="text-danger small">
                                            </span>

                                        </div>

                                        <!-- TIME -->
                                        <div class="field-group mb-md-0">

                                            <label asp-for="AppointmentTime"
                                                   class="form-label">
                                                Appointment Time
                                            </label>

                                            <input asp-for="AppointmentTime"
                                                   type="time"
                                                   class="form-control" />

                                            <span asp-validation-for="AppointmentTime"
                                                  class="text-danger small">
                                            </span>

                                            <div class="form-text">
                                                Select your preferred service time.
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- COMPLAINT -->
                            <div class="complaint-section">

                                <div class="complaint-header">

                                    <div>
                                        <div class="complaint-title">
                                            Vehicle Problem / Complaint
                                        </div>

                                        <p class="complaint-help">
                                            Briefly describe the problem or service request.
                                        </p>
                                    </div>

                                    <span class="optional-badge">
                                        SERVICE DETAILS
                                    </span>

                                </div>

                                <textarea asp-for="CustomerComplaint"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Example: Engine produces unusual noise when accelerating."></textarea>

                                <span asp-validation-for="CustomerComplaint"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <!-- COMPACT FOOTER -->
                        <div class="booking-footer">

                            <div class="request-info">

                                <div class="request-icon">
                                    <i class="bi bi-info-lg"></i>
                                </div>

                                <div>
                                    <div class="request-title">
                                        Appointment Request
                                    </div>

                                    <div class="request-text">
                                        Your request will be submitted as Pending
                                        and reviewed by the workshop administrator.
                                    </div>
                                </div>

                            </div>

                            <div class="booking-actions">

                                <a asp-controller="Customer"
                                   asp-action="Dashboard"
                                   class="btn btn-outline-secondary">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-primary book-btn">

                                    <i class="bi bi-calendar2-check me-1"></i>
                                    Book Appointment

                                </button>

                            </div>

                        </div>

                    </div>

                </form>
            }

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}