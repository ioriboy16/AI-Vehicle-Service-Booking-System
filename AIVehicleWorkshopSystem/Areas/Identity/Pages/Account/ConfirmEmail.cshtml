@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Email Confirmation";

    var isSuccess = !string.IsNullOrEmpty(Model.StatusMessage) &&
                    !Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
}

<div class="auth-page">
    <div class="auth-card">

        @if (isSuccess)
        {
            <div class="status-icon success">
                <i class="bi bi-check-lg"></i>
            </div>

            <h1>Email Verified!</h1>

            <p class="auth-subtitle">
                Your email address has been successfully verified.
                Your Serish AutoCare account is now ready to use.
            </p>

            <div class="status-box success-box">
                <i class="bi bi-shield-check"></i>

                <div>
                    <strong>Account activated successfully</strong>
                    <span>
                        You can now sign in and access your Serish AutoCare account.
                    </span>
                </div>
            </div>

            <a asp-page="./Login" class="btn-primary-custom">
                <i class="bi bi-box-arrow-in-right"></i>
                Continue to Login
            </a>
        }
        else
        {
            <div class="status-icon error">
                <i class="bi bi-x-lg"></i>
            </div>

            <h1>Verification Failed</h1>

            <p class="auth-subtitle">
                We couldn't verify your email address.
                The verification link may be invalid or no longer valid.
            </p>

            <div class="status-box error-box">
                <i class="bi bi-exclamation-triangle"></i>

                <div>
                    <strong>Unable to verify email</strong>
                    <span>
                        @Model.StatusMessage
                    </span>
                </div>
            </div>

            <a asp-page="./ResendEmailConfirmation"
               class="btn-primary-custom">
                <i class="bi bi-arrow-clockwise"></i>
                Resend Verification Email
            </a>

            <div class="back-login">
                <a asp-page="./Login">
                    <i class="bi bi-arrow-left"></i>
                    Back to Login
                </a>
            </div>
        }

        <div class="security-note">
            <i class="bi bi-shield-lock"></i>
            <span>Account security by Serish AutoCare</span>
        </div>

    </div>
</div>

<style>
    .auth-page {
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #f8f9fa;
    }

    .auth-card {
        width: 100%;
        max-width: 500px;
        padding: 45px 40px 35px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .status-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
    }

        .status-icon.success {
            background: #e8f5ee;
        }

            .status-icon.success i {
                color: #198754;
                font-size: 42px;
                font-weight: 700;
            }

        .status-icon.error {
            background: #fdecec;
        }

            .status-icon.error i {
                color: #dc3545;
                font-size: 34px;
                font-weight: 700;
            }

    .auth-card h1 {
        margin-bottom: 12px;
        color: #212529;
        font-size: 28px;
        font-weight: 700;
    }

    .auth-subtitle {
        max-width: 410px;
        margin: 0 auto 28px;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.7;
    }

    .status-box {
        display: flex;
        gap: 14px;
        margin-bottom: 25px;
        padding: 16px;
        text-align: left;
        border-radius: 12px;
    }

    .success-box {
        background: #f1faf5;
        border: 1px solid #d6eee0;
    }

    .error-box {
        background: #fff4f4;
        border: 1px solid #f3d1d1;
    }

    .status-box > i {
        margin-top: 2px;
        font-size: 21px;
        flex-shrink: 0;
    }

    .success-box > i {
        color: #198754;
    }

    .error-box > i {
        color: #dc3545;
    }

    .status-box strong {
        display: block;
        margin-bottom: 4px;
        color: #212529;
        font-size: 14px;
    }

    .status-box span {
        display: block;
        color: #6c757d;
        font-size: 13px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .btn-primary-custom {
        width: 100%;
        min-height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        background: #212529;
        border-radius: 10px;
        transition: 0.2s ease;
    }

        .btn-primary-custom:hover {
            color: #ffffff;
            background: #000000;
            transform: translateY(-1px);
        }

    .back-login {
        margin-top: 20px;
    }

        .back-login a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #495057;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
        }

            .back-login a:hover {
                color: #0d6efd;
            }

    .security-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 25px;
        padding-top: 20px;
        color: #8a8f94;
        font-size: 12px;
        border-top: 1px solid #eeeeee;
    }

        .security-note i {
            color: #198754;
        }

    @@media (max-width: 576px) {
        .auth-page {
            padding: 25px 15px;
            align-items: flex-start;
        }

        .auth-card {
            padding: 35px 22px 28px;
            border-radius: 15px;
        }

        .status-icon {
            width: 72px;
            height: 72px;
        }

            .status-icon.success i {
                font-size: 36px;
            }

            .status-icon.error i {
                font-size: 30px;
            }

        .auth-card h1 {
            font-size: 24px;
        }

        .auth-subtitle {
            font-size: 14px;
        }
    }
</style>