@page
@model EmailModel

@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}


<!-- PAGE HEADER -->

<div class="account-page-header">

    <div class="account-page-icon">
        <i class="bi bi-envelope"></i>
    </div>

    <div>

        <p class="account-eyebrow mb-1">
            ACCOUNT SECURITY
        </p>

        <h2 class="fw-bold mb-1">
            Email Address
        </h2>

        <p class="text-muted mb-0">
            Manage the email address associated with your account.
        </p>

    </div>

</div>


<!-- STATUS MESSAGE -->

<partial name="_StatusMessage"
         for="StatusMessage" />


<form id="email-form"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3"
         role="alert">
    </div>


    <!-- CURRENT EMAIL -->

    <div class="account-field">

        <label asp-for="Email"
               class="account-field-label">

            Current Email Address

        </label>


        <div class="account-input-wrapper">

            <i class="bi bi-envelope"></i>

            <input asp-for="Email"
                   class="form-control account-input"
                   disabled />

        </div>


        @if (Model.IsEmailConfirmed)
        {
            <div class="account-status account-status-success">

                <i class="bi bi-patch-check-fill"></i>

                <div>

                    <strong>
                        Email verified
                    </strong>

                    <span>
                        This email address has been verified.
                    </span>

                </div>

            </div>
        }
        else
        {
            <div class="account-status account-status-warning">

                <i class="bi bi-exclamation-circle"></i>

                <div class="flex-grow-1">

                    <strong>
                        Email not verified
                    </strong>

                    <span>
                        Verify your email address to improve account security.
                    </span>

                </div>


                <button id="email-verification"
                        type="submit"
                        asp-page-handler="SendVerificationEmail"
                        class="btn btn-sm btn-outline-primary">

                    Send Verification

                </button>

            </div>
        }

    </div>


    <!-- NEW EMAIL -->

    <div class="account-field mb-0">

        <label asp-for="Input.NewEmail"
               class="account-field-label">

            New Email Address

        </label>


        <div class="account-input-wrapper">

            <i class="bi bi-envelope-plus"></i>

            <input asp-for="Input.NewEmail"
                   class="form-control account-input"
                   autocomplete="email"
                   aria-required="true"
                   placeholder="Enter your new email address" />

        </div>


        <span asp-validation-for="Input.NewEmail"
              class="text-danger small">
        </span>


        <div class="account-field-help">
            A confirmation process may be required when changing your email address.
        </div>

    </div>


    <!-- FOOTER -->

    <div class="account-form-footer">

        <div class="account-save-info">

            <i class="bi bi-shield-check"></i>

            <span>
                Your email is used for account access and important notifications.
            </span>

        </div>


        <button id="change-email-button"
                type="submit"
                asp-page-handler="ChangeEmail"
                class="btn btn-primary px-4">

            <i class="bi bi-check-lg me-1"></i>

            Change Email

        </button>

    </div>

</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}