@{
    Layout = "/Views/Shared/_Layout.cshtml";
}


<section class="account-settings-page">

    <div class="container py-5">

        <!-- HEADER -->

        <div class="account-settings-heading">

            <p class="account-eyebrow mb-2">
                SERISH AUTOCARE
            </p>

            <h1 class="fw-bold mb-2">
                Account Settings
            </h1>

            <p class="text-muted mb-0">
                Manage your profile, security and account preferences.
            </p>

        </div>


        <!-- SETTINGS LAYOUT -->

        <div class="account-settings-shell">

            <!-- LEFT NAVIGATION -->

            <aside class="account-settings-nav">

                <div class="account-settings-nav-title">
                    SETTINGS
                </div>

                <partial name="_ManageNav" />

            </aside>


            <!-- CONTENT -->

            <main class="account-settings-content">

                @RenderBody()

            </main>

        </div>

    </div>

</section>


@section Scripts {

    @await RenderSectionAsync(
    "Scripts",
        required: false
    )

}