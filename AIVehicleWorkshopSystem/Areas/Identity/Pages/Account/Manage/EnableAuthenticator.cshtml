@page
@model EnableAuthenticatorModel

@{
    ViewData["Title"] = "Configure Authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}


<div class="account-page-header">

    <div class="account-page-icon">
        <i class="bi bi-shield-lock"></i>
    </div>

    <div>

        <p class="account-eyebrow mb-1">
            TWO-FACTOR AUTHENTICATION
        </p>

        <h2 class="fw-bold mb-1">
            Configure Authenticator
        </h2>

        <p class="text-muted mb-0">
            Add an authenticator app as an additional layer of security
            for your Serish AutoCare account.
        </p>

    </div>

</div>


<partial name="_StatusMessage"
         for="StatusMessage" />


<div class="authenticator-setup">


    <!-- STEP 1 -->

    <div class="authenticator-step">

        <div class="authenticator-step-number">
            1
        </div>

        <div class="authenticator-step-content">

            <h5>
                Install an authenticator app
            </h5>

            <p>
                Install an authenticator application such as
                Microsoft Authenticator or Google Authenticator
                on your mobile device.
            </p>

        </div>

    </div>


    <!-- STEP 2 -->

    <div class="authenticator-step">

        <div class="authenticator-step-number">
            2
        </div>

        <div class="authenticator-step-content">

            <h5>
                Scan the QR code
            </h5>

            <p>
                Open your authenticator app, add a new account,
                then scan the QR code below.
            </p>


            <div class="authenticator-qr-card">

                <div class="authenticator-qr">

                    <img src="data:image/png;base64,@Model.QrCodeImage"
                         alt="Serish AutoCare authenticator QR code" />

                </div>


                <div class="authenticator-manual">

                    <span class="authenticator-manual-label">
                        Can't scan the QR code?
                    </span>

                    <p>
                        Enter this setup key manually in your
                        authenticator app.
                    </p>

                    <div class="authenticator-key">

                        <code id="authenticator-key">
                            @Model.SharedKey
                        </code>

                        <button type="button"
                                class="authenticator-copy-button"
                                id="copy-authenticator-key"
                                title="Copy setup key">

                            <i class="bi bi-copy"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- STEP 3 -->

    <div class="authenticator-step">

        <div class="authenticator-step-number">
            3
        </div>

        <div class="authenticator-step-content">

            <h5>
                Verify your authenticator
            </h5>

            <p>
                Enter the verification code currently displayed
                in your authenticator app.
            </p>


            <form id="send-code"
                  method="post"
                  class="authenticator-verification-form">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert">
                </div>


                <div class="account-field mb-0">

                    <label asp-for="Input.Code"
                           class="account-field-label">

                        Verification Code

                    </label>


                    <div class="account-input-wrapper">

                        <i class="bi bi-123"></i>

                        <input asp-for="Input.Code"
                               class="form-control account-input authenticator-code-input"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               maxlength="7"
                               placeholder="Enter 6-digit code" />

                    </div>


                    <span asp-validation-for="Input.Code"
                          class="text-danger small">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-primary mt-3 px-4">

                    <i class="bi bi-shield-check me-1"></i>

                    Verify & Enable 2FA

                </button>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .getElementById("copy-authenticator-key")
            ?.addEventListener("click", async function () {

                const key =
                    document
                        .getElementById("authenticator-key")
                        .innerText
                        .trim();

                try {

                    await navigator.clipboard.writeText(key);

                    const icon =
                        this.querySelector("i");

                    icon.classList.remove("bi-copy");
                    icon.classList.add("bi-check-lg");

                    setTimeout(function () {

                        icon.classList.remove("bi-check-lg");
                        icon.classList.add("bi-copy");

                    }, 1500);

                }
                catch {

                    console.log(
                        "Unable to copy authenticator key."
                    );

                }

            });

    </script>

}