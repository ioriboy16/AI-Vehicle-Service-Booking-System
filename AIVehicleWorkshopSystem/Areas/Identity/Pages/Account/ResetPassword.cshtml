@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h1>Create New Password</h1>

        <p class="auth-subtitle">
            Enter your email address and create a new password for your
            Serish AutoCare account.
        </p>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger text-start"
                 role="alert">
            </div>

            <input asp-for="Input.Code" type="hidden" />

            <!-- Email -->
            <div class="form-group-custom">
                <label asp-for="Input.Email" class="form-label-custom">
                    Email Address
                </label>

                <div class="input-wrapper">
                    <i class="bi bi-envelope"></i>

                    <input asp-for="Input.Email"
                           class="form-control-custom"
                           autocomplete="email"
                           aria-required="true"
                           placeholder="Enter your email address" />
                </div>

                <span asp-validation-for="Input.Email"
                      class="text-danger validation-message">
                </span>
            </div>

            <!-- New Password -->
            <div class="form-group-custom">
                <label asp-for="Input.Password" class="form-label-custom">
                    New Password
                </label>

                <div class="input-wrapper password-wrapper">
                    <i class="bi bi-lock"></i>

                    <input asp-for="Input.Password"
                           class="form-control-custom password-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Enter your new password" />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Show or hide password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.Password"
                      class="text-danger validation-message">
                </span>
            </div>

            <!-- Confirm Password -->
            <div class="form-group-custom">
                <label asp-for="Input.ConfirmPassword" class="form-label-custom">
                    Confirm New Password
                </label>

                <div class="input-wrapper password-wrapper">
                    <i class="bi bi-lock-fill"></i>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control-custom password-input"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm your new password" />

                    <button type="button"
                            class="password-toggle"
                            aria-label="Show or hide password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger validation-message">
                </span>
            </div>

            <div class="password-info">
                <i class="bi bi-info-circle"></i>

                <div>
                    <strong>Password requirements</strong>
                    <span>
                        Use a secure password that meets the account
                        password requirements.
                    </span>
                </div>
            </div>

            <button type="submit" class="btn-reset">
                <i class="bi bi-check-circle"></i>
                Reset Password
            </button>

        </form>

        <div class="back-login">
            <a asp-page="./Login">
                <i class="bi bi-arrow-left"></i>
                Back to Login
            </a>
        </div>

        <div class="security-note">
            <i class="bi bi-shield-check"></i>
            <span>Secure password recovery by Serish AutoCare</span>
        </div>

    </div>
</div>

<style>
    .auth-page {
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #f8f9fa;
    }

    .auth-card {
        width: 100%;
        max-width: 500px;
        padding: 45px 40px 35px;
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .auth-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #eef3ff;
        border-radius: 50%;
    }

        .auth-icon i {
            color: #0d6efd;
            font-size: 36px;
        }

    .auth-card h1 {
        margin-bottom: 12px;
        color: #212529;
        font-size: 28px;
        font-weight: 700;
        text-align: center;
    }

    .auth-subtitle {
        max-width: 410px;
        margin: 0 auto 30px;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.7;
        text-align: center;
    }

    .form-group-custom {
        margin-bottom: 20px;
    }

    .form-label-custom {
        display: block;
        margin-bottom: 8px;
        color: #343a40;
        font-size: 14px;
        font-weight: 600;
    }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper > i:first-child {
            position: absolute;
            top: 50%;
            left: 16px;
            z-index: 2;
            color: #8b9298;
            font-size: 18px;
            transform: translateY(-50%);
            pointer-events: none;
        }

    .form-control-custom {
        width: 100%;
        height: 52px;
        padding: 0 16px 0 48px;
        color: #212529;
        font-size: 15px;
        background: #ffffff;
        border: 1px solid #dfe3e7;
        border-radius: 10px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .password-wrapper .form-control-custom {
        padding-right: 50px;
    }

    .form-control-custom::placeholder {
        color: #adb5bd;
    }

    .form-control-custom:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.10);
    }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 5px;
        color: #6c757d;
        font-size: 18px;
        background: transparent;
        border: none;
        transform: translateY(-50%);
        cursor: pointer;
    }

        .password-toggle:hover {
            color: #212529;
        }

    .validation-message {
        display: block;
        margin-top: 6px;
        font-size: 13px;
    }

    .password-info {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        padding: 14px 15px;
        text-align: left;
        background: #f4f8ff;
        border: 1px solid #dbe8ff;
        border-radius: 10px;
    }

        .password-info > i {
            margin-top: 2px;
            color: #0d6efd;
            font-size: 18px;
            flex-shrink: 0;
        }

        .password-info strong {
            display: block;
            margin-bottom: 3px;
            color: #343a40;
            font-size: 13px;
        }

        .password-info span {
            display: block;
            color: #6c757d;
            font-size: 12px;
            line-height: 1.5;
        }

    .btn-reset {
        width: 100%;
        min-height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        background: #212529;
        border: none;
        border-radius: 10px;
        transition: 0.2s ease;
    }

        .btn-reset:hover {
            background: #000000;
            transform: translateY(-1px);
        }

        .btn-reset:active {
            transform: translateY(0);
        }

    .back-login {
        margin-top: 22px;
        text-align: center;
    }

        .back-login a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #495057;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
        }

            .back-login a:hover {
                color: #0d6efd;
            }

    .security-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 25px;
        padding-top: 20px;
        color: #8a8f94;
        font-size: 12px;
        border-top: 1px solid #eeeeee;
    }

        .security-note i {
            color: #198754;
        }

    .validation-summary-valid {
        display: none;
    }

    @@media (max-width: 576px) {
        .auth-page {
            padding: 25px 15px;
            align-items: flex-start;
        }

        .auth-card {
            padding: 35px 22px 28px;
            border-radius: 15px;
        }

        .auth-icon {
            width: 72px;
            height: 72px;
        }

            .auth-icon i {
                font-size: 31px;
            }

        .auth-card h1 {
            font-size: 24px;
        }

        .auth-subtitle {
            font-size: 14px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.password-toggle').forEach(function (button) {
            button.addEventListener('click', function () {
                const wrapper = button.closest('.password-wrapper');
                const input = wrapper.querySelector('.password-input');
                const icon = button.querySelector('i');

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}