@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <h1>Password Reset Successful</h1>

        <p class="auth-subtitle">
            Your password has been updated successfully.
            You can now sign in to your Serish AutoCare account
            using your new password.
        </p>

        <div class="success-box">
            <i class="bi bi-shield-check"></i>

            <div>
                <strong>Your account is ready</strong>
                <span>
                    For your security, remember to keep your new password
                    private and do not share it with anyone.
                </span>
            </div>
        </div>

        <a asp-page="./Login" class="btn-login">
            <i class="bi bi-box-arrow-in-right"></i>
            Continue to Login
        </a>

        <div class="security-note">
            <i class="bi bi-lock"></i>
            <span>Account security by Serish AutoCare</span>
        </div>

    </div>
</div>

<style>
    .auth-page {
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #f8f9fa;
    }

    .auth-card {
        width: 100%;
        max-width: 500px;
        padding: 45px 40px 35px;
        text-align: center;
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 18px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .success-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #e8f5ee;
        border-radius: 50%;
    }

        .success-icon i {
            color: #198754;
            font-size: 42px;
            font-weight: 700;
        }

    .auth-card h1 {
        margin-bottom: 12px;
        color: #212529;
        font-size: 28px;
        font-weight: 700;
    }

    .auth-subtitle {
        max-width: 410px;
        margin: 0 auto 28px;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.7;
    }

    .success-box {
        display: flex;
        gap: 14px;
        margin-bottom: 25px;
        padding: 16px;
        text-align: left;
        background: #f1faf5;
        border: 1px solid #d6eee0;
        border-radius: 12px;
    }

        .success-box > i {
            margin-top: 2px;
            color: #198754;
            font-size: 21px;
            flex-shrink: 0;
        }

        .success-box strong {
            display: block;
            margin-bottom: 4px;
            color: #212529;
            font-size: 14px;
        }

        .success-box span {
            display: block;
            color: #6c757d;
            font-size: 13px;
            line-height: 1.5;
        }

    .btn-login {
        width: 100%;
        min-height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        background: #212529;
        border-radius: 10px;
        transition: 0.2s ease;
    }

        .btn-login:hover {
            color: #ffffff;
            background: #000000;
            transform: translateY(-1px);
        }

    .security-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 25px;
        padding-top: 20px;
        color: #8a8f94;
        font-size: 12px;
        border-top: 1px solid #eeeeee;
    }

        .security-note i {
            color: #198754;
        }

    @@media (max-width: 576px) {
        .auth-page {
            padding: 25px 15px;
            align-items: flex-start;
        }

        .auth-card {
            padding: 35px 22px 28px;
            border-radius: 15px;
        }

        .success-icon {
            width: 72px;
            height: 72px;
        }

            .success-icon i {
                font-size: 36px;
            }

        .auth-card h1 {
            font-size: 24px;
        }

        .auth-subtitle {
            font-size: 14px;
        }
    }
</style>