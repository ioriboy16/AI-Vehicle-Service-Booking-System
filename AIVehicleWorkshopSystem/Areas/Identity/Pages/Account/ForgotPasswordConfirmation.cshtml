@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-envelope-check"></i>
        </div>

        <h1>Check Your Email</h1>

        <p class="auth-subtitle">
            We've sent password reset instructions to your email address.
        </p>

        <div class="info-box">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>Didn't receive the email?</strong>
                <span>
                    Please check your spam or junk folder. It may take a few
                    moments for the email to arrive.
                </span>
            </div>
        </div>

        <a asp-page="./Login" class="btn-back-login">
            <i class="bi bi-arrow-left"></i>
            Back to Login
        </a>

        <div class="security-note">
            <i class="bi bi-shield-check"></i>
            <span>Secure password recovery by Serish AutoCare</span>
        </div>

    </div>
</div>

<style>
    .auth-page {
        min-height: calc(100vh - 140px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        background: #f8f9fa;
    }

    .auth-card {
        width: 100%;
        max-width: 500px;
        background: #ffffff;
        border-radius: 18px;
        padding: 45px 40px 35px;
        text-align: center;
        border: 1px solid #e9ecef;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    .auth-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #e8f5ee;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .auth-icon i {
            font-size: 38px;
            color: #198754;
        }

    .auth-card h1 {
        margin-bottom: 12px;
        font-size: 28px;
        font-weight: 700;
        color: #212529;
    }

    .auth-subtitle {
        max-width: 390px;
        margin: 0 auto 28px;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.7;
    }

    .info-box {
        display: flex;
        gap: 14px;
        text-align: left;
        background: #f4f8ff;
        border: 1px solid #dbe8ff;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 25px;
    }

        .info-box > i {
            color: #0d6efd;
            font-size: 20px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .info-box strong {
            display: block;
            color: #212529;
            font-size: 14px;
            margin-bottom: 4px;
        }

        .info-box span {
            display: block;
            color: #6c757d;
            font-size: 13px;
            line-height: 1.5;
        }

    .btn-back-login {
        width: 100%;
        min-height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        border-radius: 10px;
        background: #212529;
        color: #ffffff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-back-login:hover {
            background: #000000;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .security-note {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 7px;
        margin-top: 24px;
        color: #8a8f94;
        font-size: 12px;
    }

        .security-note i {
            color: #198754;
        }

    @@media (max-width: 576px) {
        .auth-page {
            padding: 25px 15px;
            align-items: flex-start;
        }

        .auth-card {
            padding: 35px 22px 28px;
            border-radius: 15px;
        }

        .auth-icon {
            width: 72px;
            height: 72px;
        }

            .auth-icon i {
                font-size: 32px;
            }

        .auth-card h1 {
            font-size: 24px;
        }
    }
</style>